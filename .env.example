VITE_COMPETITOR_LOOKUP_ENDPOINT=http://127.0.0.1:8787/api/competitor-lookup
VITE_COMPETITOR_APPROVAL_ENDPOINT=http://127.0.0.1:8787/api/competitor-approvals
VITE_APP_VERSION=
VITE_APP_COMMIT=
VITE_BUILD_NUMBER=
VITE_BUILD_DATE=
VITE_BUILD_CHANNEL=

# Optional backend config for `npm run dev:lookup-api`
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_COMPETITOR_APPROVALS_TABLE=competitor_approvals
SUPABASE_LOOKUP_DIAGNOSTICS_TABLE=competitor_lookup_runtime_events

LOOKUP_ENABLE_LIVE_ENRICHMENT=true
LOOKUP_RETRY_ATTEMPTS=3
LOOKUP_TIMEOUT_MS=4500
LOOKUP_CACHE_TTL_MS=1800000
LOOKUP_CACHE_MAX_ENTRIES=500
LOOKUP_RATE_LIMIT_WINDOW_MS=60000
LOOKUP_RATE_LIMIT_MAX_REQUESTS=12
LOOKUP_RUNTIME_EVENT_MAX=120
LOOKUP_RUNTIME_EVENT_RETENTION_DAYS=30
LOOKUP_PERSIST_RUNTIME_EVENTS=true
