# ============================================================================
# Server Configuration
# ============================================================================
# Backend server host/port (used by competitor-lookup-server.mjs)
HOST=127.0.0.1
PORT=8787

# UI server host/port
WINGMAN_UI_HOST=127.0.0.1
WINGMAN_UI_PORT=3000

# ============================================================================
# CORS Configuration
# ============================================================================
# CORS origin for API responses. Set to your frontend URL in production.
# Use "*" for open access (disables credentials). Falls back to http://{WINGMAN_UI_HOST}:{WINGMAN_UI_PORT}
WINGMAN_CORS_ALLOW_ORIGIN=http://127.0.0.1:3000

# ============================================================================
# Security Configuration
# ============================================================================
WINGMAN_MAX_JSON_BODY_BYTES=1048576
# Set to true in production when using HTTPS
WINGMAN_SESSION_COOKIE_SECURE=false
WINGMAN_ENABLE_SECURITY_HEADERS=true
WINGMAN_API_CONTENT_SECURITY_POLICY=default-src 'none'; frame-ancestors 'none'; base-uri 'none'
WINGMAN_API_HSTS=max-age=31536000; includeSubDomains
# Enables double-submit CSRF cookie enforcement. Set to true in production.
WINGMAN_CSRF_ENFORCE=false

# ============================================================================
# Vite / Frontend Configuration
# ============================================================================
# Backend host/port that Vite proxy forwards /api requests to
VITE_WINGMAN_LOCAL_BACKEND_HOST=127.0.0.1
VITE_WINGMAN_LOCAL_BACKEND_PORT=8787

# Override the full API proxy target URL (takes precedence over host/port above)
# Example for production: VITE_API_PROXY_TARGET=https://api.example.com
VITE_API_PROXY_TARGET=

# Vite dev server host. Set to "0.0.0.0" to listen on all interfaces.
# Falls back to WINGMAN_UI_HOST if not set.
VITE_SERVER_HOST=127.0.0.1

# Frontend API endpoints (used by client-side code)
VITE_COMPETITOR_LOOKUP_ENDPOINT=http://127.0.0.1:8787/api/competitor-lookup
VITE_COMPETITOR_APPROVAL_ENDPOINT=http://127.0.0.1:8787/api/competitor-approvals
VITE_PRODUCT_INTELLIGENCE_ENDPOINT=http://127.0.0.1:8787/api/product-intelligence
VITE_PRODUCT_INTELLIGENCE_HEALTH_ENDPOINT=http://127.0.0.1:8787/api/product-intelligence/health
VITE_WINGMAN_API_BASE_URL=http://127.0.0.1:8787/api/wingman
VITE_WINGMAN_ENABLE_PROJECT_BACKEND_SYNC=false

# Build metadata
VITE_APP_VERSION=
VITE_APP_COMMIT=
VITE_BUILD_NUMBER=
VITE_BUILD_DATE=
VITE_BUILD_CHANNEL=
VITE_WINGMAN_ENABLE_GURU_EXTERNAL_LOOKUP=false

# ============================================================================
# Supabase Configuration
# ============================================================================
# Supabase is used for persistent storage in production deployments.
# See docs/SUPABASE_SETUP.md for complete setup instructions.
#
# Get these values from your Supabase project:
#   1. Go to https://supabase.com/dashboard
#   2. Select your project (or create a new one)
#   3. Go to Project Settings > API
#   4. Copy "Project URL" to SUPABASE_URL
#   5. Copy "service_role" key (not anon key!) to SUPABASE_SERVICE_ROLE_KEY
#
# WARNING: The service_role key has full database access. Never expose it to clients.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Tables for competitor lookup service (optional)
SUPABASE_COMPETITOR_APPROVALS_TABLE=competitor_approvals
SUPABASE_LOOKUP_DIAGNOSTICS_TABLE=competitor_lookup_runtime_events

# ============================================================================
# Lookup Service Configuration
# ============================================================================
LOOKUP_ENABLE_LIVE_ENRICHMENT=true
LOOKUP_RETRY_ATTEMPTS=3
LOOKUP_TIMEOUT_MS=4500
LOOKUP_CACHE_TTL_MS=1800000
LOOKUP_CACHE_MAX_ENTRIES=500
LOOKUP_RATE_LIMIT_WINDOW_MS=60000
LOOKUP_RATE_LIMIT_MAX_REQUESTS=12
LOOKUP_RUNTIME_EVENT_MAX=120
LOOKUP_RUNTIME_EVENT_RETENTION_DAYS=30
LOOKUP_PERSIST_RUNTIME_EVENTS=true

# ============================================================================
# Session & Auth Configuration
# ============================================================================
WINGMAN_SESSION_TTL_MS=604800000
WINGMAN_INVITATION_TTL_MS=604800000
WINGMAN_AUTH_RATE_LIMIT_WINDOW_MS=60000
WINGMAN_AUTH_RATE_LIMIT_MAX_REQUESTS=8
WINGMAN_AUDIT_RETENTION=800
WINGMAN_TELEMETRY_RETENTION=400
WINGMAN_STORAGE_MODE=auto
WINGMAN_STORAGE_FAIL_CLOSED=false

# ============================================================================
# Wingman Storage Configuration
# ============================================================================
# Storage mode determines where Wingman persists application data:
#
#   "file"           - Local JSON file storage (default for development)
#   "supabase"       - Single-row JSON storage in Supabase (simple, but limited)
#   "supabase-tables"- Normalized relational tables (recommended for production)
#   "auto"           - Automatically selects based on available configuration
#
# For production, use "supabase-tables" with SUPABASE_WINGMAN_TABLES_ENABLED=true
# Run the migration at server/migrations/001_initial_schema.sql before enabling.

WINGMAN_STORAGE_MODE=auto

# When true, the server will fail to start if the configured storage is unavailable.
# Set to true in production to prevent silent fallback to file storage.
WINGMAN_STORAGE_FAIL_CLOSED=false

# ============================================================================
# Supabase Wingman Tables Configuration
# ============================================================================
# Enable normalized table storage (requires running the migration first)
# This provides better performance, querying, and data integrity for production.
SUPABASE_WINGMAN_TABLES_ENABLED=false

# Table names (customize if using a shared database or specific naming convention)
SUPABASE_WINGMAN_STATE_TABLE=wingman_app_state
SUPABASE_WINGMAN_STATE_ROW_ID=global
SUPABASE_WINGMAN_USERS_TABLE=wingman_users
SUPABASE_WINGMAN_WORKSPACES_TABLE=wingman_workspaces
SUPABASE_WINGMAN_MEMBERS_TABLE=wingman_workspace_members
SUPABASE_WINGMAN_INVITATIONS_TABLE=wingman_workspace_invitations
SUPABASE_WINGMAN_SESSIONS_TABLE=wingman_sessions
SUPABASE_WINGMAN_PROJECTS_TABLE=wingman_projects
SUPABASE_WINGMAN_AUDIT_TABLE=wingman_audit_events
SUPABASE_WINGMAN_TELEMETRY_TABLE=wingman_telemetry_events

# ============================================================================
# Google Custom Search API (for live competitor lookups)
# ============================================================================
# Google Custom Search Engine API key. Used for external search enrichment.
# Get your key at: https://developers.google.com/custom-search/v1/introduction
GOOGLE_CSE_API_KEY=
# Alternative name (same purpose)
GOOGLE_CUSTOM_SEARCH_API_KEY=

# ============================================================================
# AI / LLM Configuration
# ============================================================================
# Without this, the Guru agent automatically falls back to rule-based mock
# responses (see server/server/agents/config.mjs: shouldUseMockMode()).
GEMINI_API_KEY=
GURU_GEMINI_MODEL=gemini-2.5-flash
# Forces mock mode even when GEMINI_API_KEY is set. Leave false/unset in
# production - this should only be used for local development or tests.
WINGMAN_AGENT_FORCE_MOCK=false
