{
  "version": 1,
  "updatedAt": "2026-08-18",
  "policy": {
    "principle": "Preserve the manufacturer's technology name separately from the canonical transport or codec standard. Canonical equivalence never implies plug-compatibility.",
    "standardRelationships": [
      "native",
      "certified",
      "compatible",
      "selectable-mode",
      "based-on",
      "proprietary",
      "not-applicable",
      "unknown"
    ],
    "unknownRule": "If an official source does not establish a standards relationship, retain the vendor technology and mark the relationship unknown or proprietary rather than guessing."
  },
  "rules": [
    {
      "id": "crestron-dm8g-plus-hdbaset",
      "priority": 40,
      "manufacturerPattern": "^Crestron$",
      "textPattern": "\\bDM\\s*8G\\+\\b|DigitalMedia\\s*8G\\+",
      "vendorTechnology": "Crestron DigitalMedia 8G+",
      "canonicalTransport": "HDBaseT",
      "transportFamily": "twisted-pair",
      "standardRelationship": "certified",
      "interoperability": "third-party-compatible",
      "medium": "CAT twisted pair",
      "evidenceUrl": "https://www.crestron.com/Products/Catalog/Inactive/Discontinued/D/DMPS-300-C",
      "evidenceStatement": "Crestron states DM 8G+ is designed using HDBaseT Alliance specifications and supports interoperability with HDBaseT products."
    },
    {
      "id": "crestron-dm8g-fiber",
      "priority": 60,
      "manufacturerPattern": "^Crestron$",
      "textPattern": "\\bDM\\s*8G\\s*(?:SM\\s*)?Fiber\\b|DigitalMedia\\s*8G\\s*(?:Single[- ]Mode\\s*)?Fiber",
      "vendorTechnology": "Crestron DigitalMedia 8G Fiber",
      "canonicalTransport": "DigitalMedia fiber",
      "transportFamily": "fiber",
      "standardRelationship": "proprietary",
      "interoperability": "vendor-ecosystem",
      "medium": "fiber",
      "evidenceUrl": "https://www.crestron.com/Products/Catalog/Inactive/Discontinued/D/DM-MD64X64",
      "evidenceStatement": "DigitalMedia fiber is a separate transport from DM 8G+ twisted-pair HDBaseT."
    },
    {
      "id": "extron-dtp-family",
      "priority": 20,
      "manufacturerPattern": "^Extron$",
      "textPattern": "\\bDTP(?:2|3)?\\b",
      "vendorTechnology": "Extron DTP",
      "canonicalTransport": "Extron DTP twisted-pair AV",
      "transportFamily": "twisted-pair",
      "standardRelationship": "proprietary",
      "interoperability": "requires-matched-endpoint",
      "medium": "shielded CAT twisted pair",
      "evidenceUrl": "https://www.extron.com/article/hdbaset",
      "evidenceStatement": "DTP is retained as the vendor technology. Only products explicitly identified by Extron as HDBaseT compatible are promoted to HDBaseT compatibility."
    },
    {
      "id": "extron-dtp-hdbaset-compatible-models",
      "priority": 70,
      "manufacturerPattern": "^Extron$",
      "skuPattern": "^(?:DTP3\\s+CROSSPOINT\\s+(?:662|642|622|884)|DTP3\\s+T\\s+(?:202(?:\\s+EU/MK)?|212\\s+D|101\\s+D|203)|DTP2\\s+T\\s+(?:201\\s+D|202\\s+FB|203|204|212)|DTP\\s+CROSSPOINT\\s+(?:84|84\\s+4K|82\\s+4K))$",
      "vendorTechnology": "Extron DTP",
      "canonicalTransport": "HDBaseT",
      "transportFamily": "twisted-pair",
      "standardRelationship": "selectable-mode",
      "interoperability": "third-party-compatible",
      "medium": "shielded CAT twisted pair",
      "evidenceUrl": "https://www.extron.com/article/hdbaset",
      "evidenceStatement": "Extron lists these models as providing selectable or compatible HDBaseT operation."
    },
    {
      "id": "lightware-tps-hdbaset",
      "priority": 50,
      "manufacturerPattern": "^Lightware$",
      "textPattern": "\\bTPS\\b",
      "vendorTechnology": "Lightware TPS",
      "canonicalTransport": "HDBaseT",
      "transportFamily": "twisted-pair",
      "standardRelationship": "based-on",
      "interoperability": "third-party-compatible",
      "medium": "CAT twisted pair",
      "evidenceUrl": "https://assets.prod.pim.lightware.com/assets/File-Downloads/Guides-and-Manuals/User-Manual/HTML/HDMI-TPS-TX200_series/UM.html",
      "evidenceStatement": "Lightware states the TPS interface uses HDBaseT technology and provides an HDBaseT operating mode."
    },
    {
      "id": "amx-dxlink-fiber",
      "priority": 70,
      "manufacturerPattern": "^AMX$",
      "textPattern": "\\bDXLink\\b.*\\bFiber\\b|\\bDXF(?:P)?-(?:TX|RX)",
      "vendorTechnology": "AMX DXLink Fiber",
      "canonicalTransport": "DXLink Fiber",
      "transportFamily": "fiber",
      "standardRelationship": "proprietary",
      "interoperability": "vendor-ecosystem",
      "medium": "fiber",
      "evidenceUrl": "https://www.amx.com/en-US/product_families/dxlink-fiber-100m",
      "evidenceStatement": "DXLink Fiber is a distinct fiber transport family and must not be normalised to HDBaseT."
    },
    {
      "id": "amx-dxlink-twisted-pair",
      "priority": 20,
      "manufacturerPattern": "^AMX$",
      "textPattern": "\\bDXLink\\b",
      "vendorTechnology": "AMX DXLink",
      "canonicalTransport": "AMX DXLink twisted-pair AV",
      "transportFamily": "twisted-pair",
      "standardRelationship": "unknown",
      "interoperability": "vendor-ecosystem",
      "medium": "CAT twisted pair",
      "evidenceStatement": "Do not assume all DXLink products are HDBaseT. Promote to HDBaseT only where the product evidence explicitly confirms compatibility or compliance."
    },
    {
      "id": "crestron-dm-nvx",
      "priority": 50,
      "manufacturerPattern": "^Crestron$",
      "skuPattern": "^DM[- ]?NVX[- ]",
      "vendorTechnology": "Crestron DM NVX",
      "canonicalTransport": "AV-over-IP",
      "transportFamily": "ethernet-ip",
      "standardRelationship": "proprietary",
      "interoperability": "vendor-ecosystem",
      "networkClass": "1GbE",
      "codecName": "Pixel Perfect Processing",
      "codecStandard": "Crestron proprietary",
      "compressionClass": "visually-lossless",
      "latencyClass": "ultra-low",
      "evidenceUrl": "https://docs.crestron.com/en-us/9496/Content/Topics/Specifications/Specifications-350.htm",
      "evidenceStatement": "DM NVX endpoints use 1GbE-class networking and Crestron Pixel Perfect Processing; match by capabilities rather than codec identity."
    },
