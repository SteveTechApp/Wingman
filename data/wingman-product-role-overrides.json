    },
    {
      "match": "RACK",
      "recommendationRole": "rack-mount",
      "productClass": "accessory/support",
      "lifecycleStatus": "active-review",
      "recommendationEligible": false,
      "discoveryEligible": false,
      "finderEligible": true,
      "proposalBomEligible": true,
