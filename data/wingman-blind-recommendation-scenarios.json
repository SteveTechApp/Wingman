{
  "version": 2,
  "purpose": "Blind customer requirement to recommendation acceptance scenarios.",
  "scenarios": [
    {
      "id": "blind-higher-education-avoip",
      "name": "Teaching space with network distribution",
      "input": {
        "application": "higher education teaching room requiring AV over IP distribution",
        "sourceCount": 3,
        "displayCount": 6,
        "displayBehaviour": "any source to any display",
        "distancesByScope": {
          "localPatchMetres": 2,
          "infrastructureMetres": 70
        },
        "resolution": "4K60",
        "audioNeed": "room reinforcement",
        "controlNeed": "lectern control",
        "networkNeed": "managed AV network approved"
      },
      "expected": {
        "architecture": "avoip",
        "bom": [
          { "sku": "NHD-120-IW-TX", "quantity": 3 },
          { "sku": "NHD-120-RX", "quantity": 6 },
          { "sku": "NHD-CTL-PRO-V2", "quantity": 1 },
          { "sku": "AMP-2120", "quantity": 1 },
          { "sku": "SYN-KEY10", "quantity": 1 }
        ],
        "requiredDependencies": ["avoip-encoder", "avoip-decoder", "avoip-control", "room-audio"],
        "forbidden": ["EX-"],
        "missingInformation": [],
        "quoteSafety": "do-not-quote-yet"
      }
    },
    {
