import "./wingman-dashboard.css";

type CheckState = "ok" | "warn" | "info";

const journeySteps = [
  "Discovery",
  "Room Definition",
  "Tech Selection",
  "Product Selection",
  "System Architecture",
  "Bill of Materials",
  "Proposal Output",
];

const recommendations = [
  { sku: "MX-0808-H2A-MK2", detail: "8x8 HDMI matrix core" },
  { sku: "EX-70-H2C", detail: "4K HDMI extension path" },
  { sku: "AMP-240-DNT", detail: "Audio breakout and amplification" },
];

const checks: Array<{
  title: string;
  detail: string;
  state: CheckState;
}> = [
  {
    title: "Bandwidth Check",
    detail: "Base transport bandwidth is within expected range.",
    state: "ok",
  },
  {
    title: "Distance Validation",
    detail: "HDBaseT or extender choice suitable for 50m.",
    state: "warn",
  },
  {
    title: "USB / Control",
    detail: "Control path and USB extension can be added as required.",
    state: "info",
  },
];

function CheckBadge({ state }: { state: CheckState }) {
  const className =
    state === "ok"
      ? "wm-dashboard-check__badge wm-dashboard-check__badge--ok"
      : state === "warn"
        ? "wm-dashboard-check__badge wm-dashboard-check__badge--warn"
        : "wm-dashboard-check__badge wm-dashboard-check__badge--info";

  const label = state === "ok" ? "OK" : state === "warn" ? "!" : "i";

  return <span className={className}>{label}</span>;
}

export default function DashboardPage() {
  return (
    <div className="wm-dashboard-page">
      <header className="wm-dashboard-hero">
        <div className="wm-dashboard-hero__copy">
          <div className="wm-dashboard-hero__eyebrow">System Architecture</div>
          <h1 className="wm-dashboard-hero__title">System Architecture Design</h1>
          <p className="wm-dashboard-hero__subtitle">
            Select the transport model, validate the signal flow, and move straight into BOM generation.
          </p>
        </div>

        <div className="wm-dashboard-hero__actions">
          <button className="wm-dashboard-button wm-dashboard-button--primary" type="button">
            Continue to Proposal
          </button>
          <button className="wm-dashboard-button wm-dashboard-button--secondary" type="button">
            Review Product Set
          </button>
        </div>
      </header>

      <section className="wm-dashboard-workspace">
        <aside className="wm-dashboard-rail">
          <nav className="wm-dashboard-journey" aria-label="Project workflow">
            {journeySteps.map((step) => (
              <button
                key={step}
                type="button"
                className={
                  step === "System Architecture"
                    ? "wm-dashboard-journey__item wm-dashboard-journey__item--active"
                    : "wm-dashboard-journey__item"
                }
              >
                {step}
              </button>
            ))}
          </nav>

          <div className="wm-dashboard-panel">
            <div className="wm-dashboard-panel__title">Recommendations</div>
            <div className="wm-dashboard-stack">
              {recommendations.map((item) => (
                <article key={item.sku} className="wm-dashboard-card">
                  <div className="wm-dashboard-card__sku">{item.sku}</div>
                  <div className="wm-dashboard-card__detail">{item.detail}</div>
                </article>
              ))}
            </div>
          </div>

          <div className="wm-dashboard-panel">
            <div className="wm-dashboard-panel__title">System Checks</div>
            <div className="wm-dashboard-stack">
              {checks.map((item) => (
                <article key={item.title} className="wm-dashboard-check">
                  <CheckBadge state={item.state} />
                  <div className="wm-dashboard-check__body">
                    <div className="wm-dashboard-check__title">{item.title}</div>
                    <div className="wm-dashboard-check__detail">{item.detail}</div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </aside>

        <main className="wm-dashboard-canvas">
          <div className="wm-dashboard-canvas__surface">
            <div className="wm-dashboard-canvas__grid" />

            <div className="wm-dashboard-node wm-dashboard-node--source" style={{ top: "110px", left: "56px" }}>
              Sources (4)
            </div>

            <div className="wm-dashboard-node wm-dashboard-node--core" style={{ top: "290px", left: "42%" }}>
              Matrix / Network Core
            </div>

            <div className="wm-dashboard-node wm-dashboard-node--display" style={{ top: "110px", right: "56px" }}>
              Displays (6)
            </div>

            <div className="wm-dashboard-node wm-dashboard-node--audio" style={{ top: "490px", left: "42%" }}>
              Audio Breakout
            </div>

            <svg
              className="wm-dashboard-canvas__lines"
              viewBox="0 0 1400 820"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <path d="M190 145 L520 145 L520 320 L660 320" className="wm-line wm-line--video" />
              <path d="M760 320 L880 320 L880 145 L1210 145" className="wm-line wm-line--video" />
              <path d="M710 350 L710 535" className="wm-line wm-line--audio" />
            </svg>

            <div className="wm-dashboard-legend">
              <span className="wm-dashboard-legend__item">
                <span className="wm-dashboard-legend__dot wm-dashboard-legend__dot--video" />
                Video
              </span>
              <span className="wm-dashboard-legend__item">
                <span className="wm-dashboard-legend__dot wm-dashboard-legend__dot--network" />
                Network
              </span>
              <span className="wm-dashboard-legend__item">
                <span className="wm-dashboard-legend__dot wm-dashboard-legend__dot--audio" />
                Audio
              </span>
            </div>
          </div>
        </main>
      </section>
    </div>
  );
}