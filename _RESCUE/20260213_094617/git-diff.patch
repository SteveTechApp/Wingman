+import React, { useMemo } from "react";
+import { Link } from "react-router-dom";
+
+export type ToolGridItem = {
+  title: string;
+  desc?: string;
+  to: string;
+  tag?: string;
+  badge?: string;
+  /** Optional grouping/category label used by ToolHub filtering */
+  category?: string;
+  /** Optional flag for internal/hidden tools */
+  internal?: boolean;
+  /** Optional priority pinning */
+  primary?: boolean;
+};
+
+export type ToolGridProps = {
+  /** Required: list of tools to display */
+  items?: ToolGridItem[];
+
+  /** Optional: free text filter (title/desc/tag) */
+  search?: string;
+
+  /** Optional: category filter (matches item.category OR item.tag) */
+  category?: string;
+
+  /** Optional: show internal tools; if false, internal tools are hidden */
+  showInternalOverride?: boolean;
+
+  /** Optional: bubble primary items to top (uses item.primary or title heuristics) */
+  pinPrimary?: boolean;
+
+  className?: string;
+};
+
+function norm(s: string) {
+  return (s || ").toLowerCase().trim();
+}
+
+function looksPrimary(it: ToolGridItem) {
+  if (it.primary) return true;
+  const t = norm(it.title);
+  // Heuristic pinning for common ÔÇ£topÔÇØ tools if primary flag not provided
+  return (
+    t.includes("room") ||
+    t.includes("videowall") ||
+    t.includes("templates") ||
+    t.includes("compare") ||
+    t.includes("discovery") ||
+    t.includes("proposal")
+  );
+}
+
+export default function ToolGrid(props: ToolGridProps) {
+  const { items: itemsProp, search = ",
+    category = ",
+    showInternalOverride = false,
+    pinPrimary = false,
+    className = "
+  } = props;
+
+  const defaultItems: ToolGridItem[] = [
+    { title: "Tool Hub", desc: "Browse Wingman tools", to: "/toolhub", tag: "Home", primary: true },
+    { title: "Room Wizard", desc: "Design AV rooms quickly", to: "/tools/room", tag: "Design", primary: true },
+    { title: "Video Wall", desc: "Plan LED/LCD walls", to: "/tools/videowall", tag: "Design", primary: true },
+    { title: "Templates", desc: "Start from vertical templates", to: "/tools/templates", tag: "Templates", primary: true },
+    { title: "Compare", desc: "Compare products", to: "/tools/compare", tag: "Tools" },
+    { title: "Competitor Compare", desc: "Match competitor SKUs", to: "/tools/competitor-compare", tag: "Tools" },
+    { title: "Training", desc: "Sales + AV training modules", to: "/tools/training", tag: "Training" },
+    { title: "Ask Wingman", desc: "Quick questions and guidance", to: "/tools/ask", tag: "Assist" }
+  ];
+
+  const items = (itemsProp && itemsProp.length) ? itemsProp : defaultItems;
+  const view = useMemo(() => {
+    const q = norm(search);
+    const cat = norm(category);
+
+    let list = (items || []).slice(0);
+
+    // Hide internal by default unless explicitly allowed
+    if (!showInternalOverride) {
+      list = list.filter((it) => !it.internal);
+    }
+
+    // Category filter (matches either item.category or item.tag)
+    if (cat && cat !== "all") {
+      list = list.filter((it) => {
+        const a = norm(it.category || ");
+        const b = norm(it.tag || ");
+        return a === cat || b === cat;
+      });
+    }
+
+    // Search filter
+    if (q) {
+      list = list.filter((it) => {
+        const hay = norm([it.title, it.desc, it.tag, it.category].filter(Boolean).join(" "));
+        return hay.includes(q);
+      });
+    }
+
+    // Optional pinning to top
+    if (pinPrimary) {
+      list.sort((x, y) => {
+        const ax = looksPrimary(x) ? 0 : 1;
+        const ay = looksPrimary(y) ? 0 : 1;
+        if (ax !== ay) return ax - ay;
+        return norm(x.title).localeCompare(norm(y.title));
+      });
+    } else {
+      list.sort((a, b) => norm(a.title).localeCompare(norm(b.title)));
+    }
+
+    return list;
+  }, [items, search, category, showInternalOverride, pinPrimary]);
+
+  return (
+    <div className={className}>
+      <div className="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
+        {view.map((it) => (
+          <Link
+            key={it.to + it.title}
+            to={it.to}
+            className="rounded-xl border border-white/10 bg-white/5 hover:bg-white/10 transition p-4"
+          >
+            <div className="flex items-start justify-between gap-3">
+              <div>
+                <div className="text-base font-semibold">{it.title}</div>
+                {it.desc ? (
+                  <div className="mt-1 text-sm opacity-80">{it.desc}</div>
+                ) : null}
+              </div>
+              {it.badge ? (
+                <span className="text-xs px-2 py-1 rounded-full border border-white/10 bg-white/5">
+                  {it.badge}
+                </span>
+              ) : null}
+            </div>
+            {it.tag ? <div className="mt-3 text-xs opacity-70">{it.tag}</div> : null}
+          </Link>
+        ))}
+      </div>
+    </div>
+  );
+}
