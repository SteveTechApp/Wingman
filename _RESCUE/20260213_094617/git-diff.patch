-  Where-Object { $_.Name -notmatch '\.d\.ts$' -and $_.Name -notmatch '\.(test|spec)\.' }
-
-$pathByKey = @{}
-foreach ($f in $files) {
-  $rel = $f.FullName.Substring($srcRoot.Length).TrimStart('\','/')
