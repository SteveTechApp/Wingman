-          <div className="text-\[10px]\ text-emerald-100/60\ font-mono">Used: {usage}</div>
-        ) : null}
-      </div>
-    </Link>
-  );
-}
-
-function Section({ title, items, usage }: { title: string; items: ToolLink[]; usage: Record<string, number> }) {
