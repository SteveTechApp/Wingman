import { useMemo, useState } from "react";
import {
  AlertTriangle,
  ArrowRight,
  CheckCircle2,
  Gauge,
  Monitor,
  Network,
  SlidersHorizontal,
  WandSparkles,
} from "lucide-react";
import "./wingman-dashboard.css";

type ArchitectureKey = "matrix" | "avoip" | "video-wall";

type ArchitectureOption = {
  key: ArchitectureKey;
  title: string;
  subtitle: string;
  descriptor: string;
  badge: string;
};

type ProductRecommendation = {
  name: string;
  detail: string;
};

type DiagramDevice = {
  id: string;
  label: string;
  x: number;
  y: number;
  width: number;
  height: number;
  kind: "source" | "core" | "transport" | "audio" | "display";
};

type DiagramLink = {
  id: string;
  from: string;
  to: string;
  color: "video" | "network" | "audio" | "control";
};

const architectureOptions: ArchitectureOption[] = [
  {
    key: "matrix",
    title: "Matrix Switch",
    subtitle: "Fixed I/O routing",
    descriptor: "Direct switching for compact spaces and predictable signal paths.",
    badge: "Best for boardrooms and classroom cores",
  },
  {
    key: "avoip",
    title: "AV over IP",
    subtitle: "Flexible and scalable",
    descriptor: "Modular transport for distributed rooms, long distances, and future growth.",
    badge: "Recommended for enterprise network-ready projects",
  },
  {
    key: "video-wall",
    title: "Video Wall Processor",
    subtitle: "Canvas and layout control",
    descriptor: "Composed wall layouts, presets, multiview, and operator control.",
    badge: "Best for control rooms and presentation walls",
  },
];

const productMap: Record<ArchitectureKey, ProductRecommendation[]> = {
  matrix: [
    { name: "MX-0808-H2A-MK2", detail: "8x8 HDMI matrix core" },
    { name: "EX-70-H2C", detail: "4K HDMI extension path" },
    { name: "AMP-260-DNT", detail: "Audio breakout and amplification" },
  ],
  avoip: [
    { name: "NHD-500-TX v2", detail: "4K60 AVoIP encoder" },
    { name: "NHD-500-RX v2", detail: "4K60 AVoIP decoder" },
    { name: "NHD-CTL-PRO v2", detail: "Controller and API orchestration" },
  ],
  "video-wall": [
    { name: "SW-0206-VW", detail: "Video wall processor" },
    { name: "MX-0812-SCL", detail: "Presentation switching and scaling" },
    { name: "SYN-TOUCH10", detail: "Preset recall control surface" },
  ],
};

function orthogonalPath(
  from: DiagramDevice,
  to: DiagramDevice,
): string {
  const startX = from.x + from.width;
  const startY = from.y + from.height / 2;
  const endX = to.x;
  const endY = to.y + to.height / 2;
  const midX = startX + Math.max(36, (endX - startX) / 2);

  return `M ${startX} ${startY} H ${midX} V ${endY} H ${endX}`;
}

function getDiagram(architecture: ArchitectureKey) {
  const devices: DiagramDevice[] =
    architecture === "matrix"
      ? [
          { id: "src1", label: "Laptop", x: 36, y: 70, width: 112, height: 48, kind: "source" },
          { id: "src2", label: "Wireless BYOD", x: 36, y: 150, width: 112, height: 48, kind: "source" },
          { id: "src3", label: "Media Player", x: 36, y: 230, width: 112, height: 48, kind: "source" },
          { id: "core", label: "Matrix Core", x: 300, y: 110, width: 160, height: 66, kind: "core" },
          { id: "transport", label: "HDBaseT / HDMI Outputs", x: 300, y: 225, width: 160, height: 66, kind: "transport" },
          { id: "audio", label: "Audio Breakout", x: 300, y: 340, width: 160, height: 56, kind: "audio" },
          { id: "disp1", label: "Display 01", x: 650, y: 65, width: 120, height: 72, kind: "display" },
          { id: "disp2", label: "Display 02", x: 650, y: 165, width: 120, height: 72, kind: "display" },
          { id: "disp3", label: "Display 03", x: 650, y: 265, width: 120, height: 72, kind: "display" },
          { id: "disp4", label: "Display 04", x: 650, y: 365, width: 120, height: 72, kind: "display" },
        ]
      : architecture === "video-wall"
        ? [
            { id: "src1", label: "Presentation PC", x: 36, y: 70, width: 120, height: 48, kind: "source" },
            { id: "src2", label: "Signage Player", x: 36, y: 150, width: 120, height: 48, kind: "source" },
            { id: "src3", label: "Camera Feed", x: 36, y: 230, width: 120, height: 48, kind: "source" },
            { id: "core", label: "Video Wall Processor", x: 296, y: 96, width: 184, height: 72, kind: "core" },
            { id: "transport", label: "Scaling / Canvas Engine", x: 296, y: 215, width: 184, height: 72, kind: "transport" },
            { id: "audio", label: "Audio DSP", x: 296, y: 340, width: 184, height: 56, kind: "audio" },
            { id: "disp1", label: "Wall Zone A", x: 654, y: 86, width: 124, height: 72, kind: "display" },
            { id: "disp2", label: "Wall Zone B", x: 654, y: 186, width: 124, height: 72, kind: "display" },
            { id: "disp3", label: "Wall Zone C", x: 654, y: 286, width: 124, height: 72, kind: "display" },
            { id: "disp4", label: "Preview", x: 654, y: 386, width: 124, height: 72, kind: "display" },
          ]
        : [
            { id: "src1", label: "Encoder 01", x: 36, y: 70, width: 112, height: 48, kind: "source" },
            { id: "src2", label: "Encoder 02", x: 36, y: 150, width: 112, height: 48, kind: "source" },
            { id: "src3", label: "Encoder 03", x: 36, y: 230, width: 112, height: 48, kind: "source" },
            { id: "core", label: "Managed AVoIP Switch", x: 286, y: 110, width: 192, height: 70, kind: "core" },
            { id: "transport", label: "NHD Control / Routing", x: 286, y: 225, width: 192, height: 66, kind: "transport" },
            { id: "audio", label: "Network Audio DSP", x: 286, y: 340, width: 192, height: 56, kind: "audio" },
            { id: "disp1", label: "Decoder 01", x: 654, y: 65, width: 120, height: 72, kind: "display" },
            { id: "disp2", label: "Decoder 02", x: 654, y: 165, width: 120, height: 72, kind: "display" },
            { id: "disp3", label: "Decoder 03", x: 654, y: 265, width: 120, height: 72, kind: "display" },
            { id: "disp4", label: "Decoder 04", x: 654, y: 365, width: 120, height: 72, kind: "display" },
          ];

  const links: DiagramLink[] =
    architecture === "matrix"
      ? [
          { id: "l1", from: "src1", to: "core", color: "video" },
          { id: "l2", from: "src2", to: "core", color: "video" },
          { id: "l3", from: "src3", to: "core", color: "video" },
          { id: "l4", from: "core", to: "disp1", color: "video" },
          { id: "l5", from: "core", to: "disp2", color: "video" },
          { id: "l6", from: "transport", to: "disp3", color: "control" },
          { id: "l7", from: "transport", to: "disp4", color: "control" },
          { id: "l8", from: "core", to: "audio", color: "audio" },
        ]
      : architecture === "video-wall"
        ? [
            { id: "l1", from: "src1", to: "core", color: "video" },
            { id: "l2", from: "src2", to: "core", color: "video" },
            { id: "l3", from: "src3", to: "core", color: "video" },
            { id: "l4", from: "core", to: "disp1", color: "video" },
            { id: "l5", from: "transport", to: "disp2", color: "control" },
            { id: "l6", from: "transport", to: "disp3", color: "control" },
            { id: "l7", from: "transport", to: "disp4", color: "control" },
            { id: "l8", from: "core", to: "audio", color: "audio" },
          ]
        : [
            { id: "l1", from: "src1", to: "core", color: "network" },
            { id: "l2", from: "src2", to: "core", color: "network" },
            { id: "l3", from: "src3", to: "core", color: "network" },
            { id: "l4", from: "core", to: "disp1", color: "network" },
            { id: "l5", from: "core", to: "disp2", color: "network" },
            { id: "l6", from: "transport", to: "disp3", color: "control" },
            { id: "l7", from: "transport", to: "disp4", color: "control" },
            { id: "l8", from: "core", to: "audio", color: "audio" },
          ];

  return { devices, links };
}

export default function DashboardPage() {
  const [selected, setSelected] = useState<ArchitectureKey>("matrix");

  const currentOption =
    architectureOptions.find((item) => item.key === selected) ?? architectureOptions[0];

  const recommendations = productMap[selected];
  const diagram = useMemo(() => getDiagram(selected), [selected]);

  const deviceMap = useMemo(
    () => Object.fromEntries(diagram.devices.map((device) => [device.id, device])),
    [diagram.devices],
  );

  const checks = [
    {
      title: "Bandwidth Check",
      detail:
        selected === "avoip"
          ? "Managed switch and VLAN policy required."
          : "Base transport bandwidth is within expected range.",
      tone: selected === "avoip" ? "warn" : "good",
    },
    {
      title: "Distance Validation",
      detail:
        selected === "matrix"
          ? "Validate HDBaseT or extender choice for 50m."
          : "Distributed transport is suitable for current distance.",
      tone: selected === "matrix" ? "warn" : "good",
    },
    {
      title: "USB / Control",
      detail:
        selected === "video-wall"
          ? "Preset recall and operator control should be included."
          : "Control path and USB extension can be added as required.",
      tone: "info",
    },
  ] as const;

  return (
    <div className="wingman-dashboard">
      <header className="wingman-dashboard__header">
        <div className="wingman-dashboard__header-copy">
          <span className="wingman-dashboard__eyebrow">System architecture</span>
          <h1>System Architecture Design</h1>
          <p>
            Select the transport model, validate the signal flow, and move straight
            into BOM generation.
          </p>
        </div>

        <div className="wingman-dashboard__header-actions">
          <button className="wingman-dashboard__button wingman-dashboard__button--primary" type="button">
            Continue to Proposal
            <ArrowRight size={16} />
          </button>
          <button className="wingman-dashboard__button wingman-dashboard__button--secondary" type="button">
            Review Product Set
          </button>
        </div>
      </header>

      <div className="wingman-dashboard__workspace">
        <aside className="wingman-dashboard__config-panel">
          <div className="wingman-dashboard__config-head">
            <h2>Select transport model</h2>
            <div className="wingman-dashboard__badge">
              <WandSparkles size={14} />
              Recommended: {currentOption.title}
            </div>
          </div>

          <div className="wingman-dashboard__config-list">
            {architectureOptions.map((item) => (
              <button
                key={item.key}
                type="button"
                className={`wingman-dashboard__config-card${selected === item.key ? " is-active" : ""}`}
                onClick={() => setSelected(item.key)}
              >
                <strong>{item.title}</strong>
                <span>{item.subtitle}</span>
                <p>{item.descriptor}</p>
              </button>
            ))}
          </div>
        </aside>

        <section className="wingman-dashboard__canvas-panel">
          <div className="wingman-dashboard__canvas-head">
            <div>
              <h2>{currentOption.title} schematic canvas</h2>
              <p>{currentOption.badge}</p>
            </div>

            <div className="wingman-dashboard__legend">
              <span className="is-video">Video</span>
              <span className="is-network">Network</span>
              <span className="is-audio">Audio</span>
              <span className="is-control">Control</span>
            </div>
          </div>

          <div className="wingman-dashboard__canvas">
            <svg
              className="wingman-dashboard__canvas-svg"
              viewBox="0 0 820 480"
              preserveAspectRatio="xMidYMid meet"
              aria-hidden="true"
            >
              {diagram.links.map((link) => {
                const from = deviceMap[link.from];
                const to = deviceMap[link.to];
                if (!from || !to) return null;

                return (
                  <path
                    key={link.id}
                    d={orthogonalPath(from, to)}
                    className={`wingman-dashboard__wire wingman-dashboard__wire--${link.color}`}
                  />
                );
              })}

              {diagram.devices.map((device) => (
                <g
                  key={device.id}
                  transform={`translate(${device.x}, ${device.y})`}
                  className={`wingman-dashboard__node wingman-dashboard__node--${device.kind}`}
                >
                  <rect
                    rx={14}
                    ry={14}
                    width={device.width}
                    height={device.height}
                    className="wingman-dashboard__node-shell"
                  />
                  <rect
                    x="14"
                    y={device.height / 2 - 4}
                    rx="4"
                    ry="4"
                    width="48"
                    height="8"
                    className="wingman-dashboard__node-lights"
                  />
                  <rect
                    x={device.width - 72}
                    y={device.height / 2 - 5}
                    rx="4"
                    ry="4"
                    width="46"
                    height="10"
                    className="wingman-dashboard__node-ports"
                  />
                  <text
                    x={device.width / 2}
                    y={device.height / 2 + 5}
                    textAnchor="middle"
                    className="wingman-dashboard__node-label"
                  >
                    {device.label}
                  </text>
                </g>
              ))}
            </svg>

            <div className="wingman-dashboard__canvas-footer">
              <div className="wingman-dashboard__canvas-stat">
                <Monitor size={15} />
                <span>4 Sources</span>
              </div>
              <div className="wingman-dashboard__canvas-stat">
                <Network size={15} />
                <span>6 Displays</span>
              </div>
              <div className="wingman-dashboard__canvas-stat">
                <Gauge size={15} />
                <span>50m transport path</span>
              </div>
            </div>
          </div>
        </section>

        <aside className="wingman-dashboard__rightbar">
          <div className="wingman-dashboard__panel">
            <div className="wingman-dashboard__panel-head">
              <h3>Recommendations</h3>
              <SlidersHorizontal size={15} />
            </div>

            <div className="wingman-dashboard__recommendation-list">
              {recommendations.map((item) => (
                <div key={item.name} className="wingman-dashboard__recommendation-item">
                  <strong>{item.name}</strong>
                  <span>{item.detail}</span>
                </div>
              ))}
            </div>
          </div>

          <div className="wingman-dashboard__panel">
            <div className="wingman-dashboard__panel-head">
              <h3>System Checks</h3>
              <Gauge size={15} />
            </div>

            <div className="wingman-dashboard__checks">
              {checks.map((check) => (
                <div key={check.title} className="wingman-dashboard__check">
                  <div className={`wingman-dashboard__check-icon is-${check.tone}`}>
                    {check.tone === "warn" ? (
                      <AlertTriangle size={14} />
                    ) : check.tone === "good" ? (
                      <CheckCircle2 size={14} />
                    ) : (
                      <Gauge size={14} />
                    )}
                  </div>
                  <div className="wingman-dashboard__check-copy">
                    <strong>{check.title}</strong>
                    <span>{check.detail}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </aside>
      </div>
    </div>
  );
}