.wingman-dashboard {
  display: grid;
  gap: 16px;
  width: 100%;
  min-width: 0;
  color: #eef4ff;
}

.wingman-dashboard__header,
.wingman-dashboard__config-panel,
.wingman-dashboard__canvas-panel,
.wingman-dashboard__panel {
  border: 1px solid rgba(124, 156, 220, 0.16);
  border-radius: 18px;
  background:
    radial-gradient(circle at top, rgba(63, 92, 174, 0.12), transparent 34%),
    linear-gradient(180deg, rgba(16, 23, 42, 0.96), rgba(9, 14, 29, 0.98));
  box-shadow: 0 18px 42px rgba(3, 8, 22, 0.34);
}

.wingman-dashboard__header {
  display: grid;
  grid-template-columns: minmax(0, 1.3fr) 280px;
  gap: 18px;
  padding: 20px;
  align-items: start;
}

.wingman-dashboard__eyebrow {
  display: inline-block;
  margin-bottom: 10px;
  font-size: 0.74rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: rgba(147, 180, 245, 0.82);
}

.wingman-dashboard__header-copy h1 {
  margin: 0;
  font-size: clamp(2rem, 1.7rem + 0.7vw, 2.7rem);
  line-height: 1.04;
  letter-spacing: -0.03em;
  font-weight: 700;
}

.wingman-dashboard__header-copy p {
  margin: 10px 0 0;
  max-width: 760px;
  color: rgba(203, 215, 239, 0.86);
  line-height: 1.5;
  font-size: 0.96rem;
}

.wingman-dashboard__header-actions {
  display: grid;
  gap: 10px;
  align-content: start;
}

.wingman-dashboard__button {
  appearance: none;
  width: 100%;
  min-height: 44px;
  padding: 11px 14px;
  border-radius: 12px;
  border: 1px solid rgba(124, 156, 220, 0.16);
  color: #eef4ff;
  font: inherit;
  cursor: pointer;
}

.wingman-dashboard__button--primary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(180deg, #2e66c2 0%, #24509a 100%);
  border-color: rgba(122, 177, 255, 0.35);
  box-shadow: 0 12px 24px rgba(26, 67, 138, 0.28);
}

.wingman-dashboard__button--secondary {
  background: rgba(255, 255, 255, 0.035);
}

.wingman-dashboard__workspace {
  display: grid;
  grid-template-columns: 310px minmax(0, 1fr) 320px;
  gap: 16px;
  width: 100%;
  min-width: 0;
  align-items: start;
}

.wingman-dashboard__config-panel {
  padding: 16px;
  display: grid;
  gap: 14px;
}

.wingman-dashboard__config-head {
  display: grid;
  gap: 10px;
}

.wingman-dashboard__config-head h2 {
  margin: 0;
  font-size: 1.05rem;
  font-weight: 600;
}

.wingman-dashboard__badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  width: fit-content;
  min-height: 34px;
  padding: 0 12px;
  border-radius: 999px;
  color: #d9e8ff;
  font-size: 0.82rem;
  background: rgba(94, 142, 240, 0.14);
  border: 1px solid rgba(124, 156, 220, 0.18);
}

.wingman-dashboard__config-list {
  display: grid;
  gap: 12px;
}

.wingman-dashboard__config-card {
  appearance: none;
  display: grid;
  gap: 6px;
  width: 100%;
  padding: 14px;
  text-align: left;
  border-radius: 16px;
  border: 1px solid rgba(124, 156, 220, 0.16);
  background: linear-gradient(180deg, rgba(20, 31, 55, 0.98), rgba(12, 21, 38, 1));
  color: #eef4ff;
  cursor: pointer;
}

.wingman-dashboard__config-card.is-active {
  border-color: rgba(108, 171, 255, 0.34);
  box-shadow:
    0 0 0 1px rgba(108, 171, 255, 0.12),
    0 16px 30px rgba(6, 16, 38, 0.34);
}

.wingman-dashboard__config-card strong {
  font-size: 1rem;
  font-weight: 600;
}

.wingman-dashboard__config-card span {
  color: rgba(167, 188, 225, 0.78);
  font-size: 0.84rem;
}

.wingman-dashboard__config-card p {
  margin: 0;
  color: rgba(188, 203, 232, 0.74);
  line-height: 1.45;
  font-size: 0.88rem;
}

.wingman-dashboard__canvas-panel {
  padding: 18px;
  min-width: 0;
}

.wingman-dashboard__canvas-head {
  display: flex;
  justify-content: space-between;
  align-items: start;
  gap: 14px;
}

.wingman-dashboard__canvas-head h2 {
  margin: 0;
  font-size: 1.05rem;
  font-weight: 600;
}

.wingman-dashboard__canvas-head p {
  margin: 5px 0 0;
  color: rgba(180, 198, 231, 0.76);
  font-size: 0.88rem;
  line-height: 1.45;
}

.wingman-dashboard__legend {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.wingman-dashboard__legend span {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  min-height: 30px;
  padding: 0 10px;
  border-radius: 999px;
  border: 1px solid rgba(124, 156, 220, 0.14);
  background: rgba(255, 255, 255, 0.025);
  color: rgba(222, 232, 249, 0.9);
  font-size: 0.76rem;
}

.wingman-dashboard__legend .is-video::before,
.wingman-dashboard__legend .is-network::before,
.wingman-dashboard__legend .is-audio::before,
.wingman-dashboard__legend .is-control::before {
  content: "";
  width: 8px;
  height: 8px;
  border-radius: 999px;
}

.wingman-dashboard__legend .is-video::before { background: #56a2ff; }
.wingman-dashboard__legend .is-network::before { background: #39d28a; }
.wingman-dashboard__legend .is-audio::before { background: #f5a243; }
.wingman-dashboard__legend .is-control::before { background: #d58cff; }

.wingman-dashboard__canvas {
  margin-top: 16px;
  padding: 12px;
  border-radius: 18px;
  border: 1px solid rgba(124, 156, 220, 0.14);
  background:
    linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px),
    radial-gradient(circle at top, rgba(66, 93, 190, 0.14), transparent 34%),
    linear-gradient(180deg, rgba(7, 14, 28, 0.96), rgba(7, 12, 24, 1));
  background-size: 28px 28px, 28px 28px, auto, auto;
}

.wingman-dashboard__canvas-svg {
  display: block;
  width: 100%;
  height: auto;
}

.wingman-dashboard__wire {
  fill: none;
  stroke-width: 4;
  stroke-linecap: round;
  stroke-linejoin: round;
  opacity: 0.94;
}

.wingman-dashboard__wire--video { stroke: #56a2ff; }
.wingman-dashboard__wire--network { stroke: #39d28a; }
.wingman-dashboard__wire--audio { stroke: #f5a243; }
.wingman-dashboard__wire--control { stroke: #d58cff; }

.wingman-dashboard__node-shell {
  fill: rgba(36, 49, 72, 0.96);
  stroke: rgba(158, 182, 220, 0.22);
  stroke-width: 1.5;
}

.wingman-dashboard__node-lights {
  fill: rgba(228, 237, 252, 0.16);
}

.wingman-dashboard__node-ports {
  fill: rgba(228, 237, 252, 0.12);
}

.wingman-dashboard__node-label {
  fill: #eef4ff;
  font-size: 13px;
  font-weight: 600;
}

.wingman-dashboard__node--core .wingman-dashboard__node-shell,
.wingman-dashboard__node--transport .wingman-dashboard__node-shell {
  fill: rgba(43, 57, 81, 0.95);
}

.wingman-dashboard__node--display .wingman-dashboard__node-shell {
  fill: rgba(25, 53, 92, 0.96);
}

.wingman-dashboard__canvas-footer {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 12px;
}

.wingman-dashboard__canvas-stat {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 34px;
  padding: 0 12px;
  border-radius: 999px;
  border: 1px solid rgba(124, 156, 220, 0.14);
  background: rgba(255, 255, 255, 0.025);
  color: rgba(222, 232, 249, 0.9);
  font-size: 0.8rem;
}

.wingman-dashboard__rightbar {
  display: grid;
  gap: 16px;
  align-content: start;
}

.wingman-dashboard__panel {
  padding: 16px;
}

.wingman-dashboard__panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
}

.wingman-dashboard__panel-head h3 {
  margin: 0;
  font-size: 1rem;
  font-weight: 600;
}

.wingman-dashboard__recommendation-list,
.wingman-dashboard__checks {
  display: grid;
  gap: 12px;
  margin-top: 14px;
}

.wingman-dashboard__recommendation-item,
.wingman-dashboard__check {
  display: grid;
  gap: 4px;
  padding: 12px;
  border: 1px solid rgba(124, 156, 220, 0.12);
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.025);
}

.wingman-dashboard__recommendation-item strong,
.wingman-dashboard__check-copy strong {
  font-size: 0.95rem;
  font-weight: 600;
}

.wingman-dashboard__recommendation-item span,
.wingman-dashboard__check-copy span {
  color: rgba(186, 201, 229, 0.76);
  line-height: 1.45;
  font-size: 0.88rem;
}

.wingman-dashboard__check {
  grid-template-columns: 34px 1fr;
  gap: 10px;
  align-items: start;
}

.wingman-dashboard__check-icon {
  display: inline-grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border-radius: 10px;
  background: rgba(56, 85, 148, 0.16);
  color: #bcd7ff;
}

.wingman-dashboard__check-icon.is-good {
  color: #78e39b;
  background: rgba(48, 152, 96, 0.16);
}

.wingman-dashboard__check-icon.is-warn {
  color: #ffb067;
  background: rgba(153, 86, 34, 0.16);
}

.wingman-dashboard__check-icon.is-info {
  color: #87bfff;
  background: rgba(58, 96, 160, 0.16);
}

@media (max-width: 1120px) {
  .wingman-dashboard__workspace {
    grid-template-columns: 280px minmax(0, 1fr);
  }

  .wingman-dashboard__rightbar {
    grid-column: 1 / -1;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 1100px) {
  .wingman-dashboard__header {
    grid-template-columns: 1fr;
  }

  .wingman-dashboard__workspace {
    grid-template-columns: 1fr;
  }

  .wingman-dashboard__rightbar {
    grid-template-columns: 1fr;
  }

  .wingman-dashboard__canvas-head {
    flex-direction: column;
  }
}
/* ===== DASHBOARD SCALE RESET ===== */
.wingman-dashboard,
.wingman-dashboard * {
  zoom: 1;
}

.wingman-dashboard {
  font-size: 16px !important;
  line-height: 1.4;
  transform: none !important;
  scale: 1 !important;
  max-width: none !important;
}

.wingman-dashboard__header,
.wingman-dashboard__config-panel,
.wingman-dashboard__canvas-panel,
.wingman-dashboard__panel,
.wingman-dashboard__workspace,
.wingman-dashboard__rightbar,
.wingman-dashboard__canvas,
.wingman-dashboard__config-card,
.wingman-dashboard__recommendation-item,
.wingman-dashboard__check {
  transform: none !important;
  scale: 1 !important;
}

.wingman-dashboard__workspace {
  grid-template-columns: 310px minmax(640px, 1fr) 320px !important;
  align-items: start !important;
}

.wingman-dashboard__canvas-panel {
  min-width: 640px !important;
}

.wingman-dashboard__canvas {
  min-height: 620px !important;
}

.wingman-dashboard__canvas-svg {
  width: 100% !important;
  min-width: 760px;
  height: auto !important;
}

.wingman-dashboard__header-copy h1 {
  font-size: 48px !important;
  line-height: 1.02 !important;
}

.wingman-dashboard__header-copy p,
.wingman-dashboard__config-card p,
.wingman-dashboard__recommendation-item span,
.wingman-dashboard__check-copy span {
  font-size: 15px !important;
}

.wingman-dashboard__config-card strong,
.wingman-dashboard__panel-head h3,
.wingman-dashboard__canvas-head h2,
.wingman-dashboard__config-head h2 {
  font-size: 18px !important;
}

.wingman-dashboard__button {
  min-height: 48px !important;
  font-size: 15px !important;
}
/* ===== DESKTOP WORKSPACE STABILITY ===== */
.wingman-dashboard__workspace {
  grid-template-columns: 280px minmax(720px, 1fr) 320px !important;
}

.wingman-dashboard__config-panel {
  min-width: 280px;
  position: relative;
  z-index: 2;
}

.wingman-dashboard__canvas-panel {
  min-width: 720px;
}

.wingman-dashboard__rightbar {
  min-width: 320px;
  position: relative;
  z-index: 2;
}

.wingman-dashboard__canvas {
  min-height: 640px;
}

.wingman-dashboard__canvas-svg {
  width: 100%;
  min-width: 820px;
  height: auto;
}