type ToolTone =
  | "blue"
  | "cyan"
  | "violet"
  | "emerald"
  | "amber"
  | "rose"
  | "indigo";

type ToolCard = {
  id: string;
  title: string;
  description: string;
  route: string;
  badge: string;
  icon: React.ComponentType<{ size?: string | number; strokeWidth?: string | number }>;
  tone: ToolTone;
};

const coreTools: ToolCard[] = [
  {
    id: "guru",
    title: "Guru Assistant",
    description:
      "Ask for product fit, system direction, next-step guidance, and quick technical support.",
    route: "/app/tools/guru",
    badge: "AI Copilot",
    icon: WandSparkles,
    tone: "violet",
  },
  {
    id: "discovery",
