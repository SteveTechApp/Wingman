function ToolCardTile({ tool }: { tool: ToolCard }) {
  const navigate = useNavigate();
  const Icon = tool.icon;

  return (
    <button
      type="button"
      className={`wm-toolhub-tile wm-toolhub-tile--${tool.tone}`}
      onClick={() => navigate(tool.route)}
    >
      <div className="wm-toolhub-tile__header">
        <span className="wm-toolhub-tile__icon">
          <Icon size={20} strokeWidth={1.9} />
        </span>
        <span className="wm-toolhub-tile__badge">{tool.badge}</span>
      </div>

      <div className="wm-toolhub-tile__body">
        <h3>{tool.title}</h3>
        <p>{tool.description}</p>
      </div>

      <div className="wm-toolhub-tile__footer">
        <span>Open tool</span>
        <ArrowRight size={16} strokeWidth={2} />
      </div>
    </button>
  );
}

function ToolSection({
  title,
  subtitle,
  tools,
}: {
  title: string;
  subtitle: string;
  tools: ToolCard[];
}) {
  return (
    <section className="wm-toolhub-section">
      <div className="wm-toolhub-section__head">
        <div>
          <div className="wm-toolhub-section__eyebrow">{title}</div>
          <h2>{subtitle}</h2>
        </div>
      </div>

      <div className="wm-toolhub-grid">
        {tools.map((tool) => (
          <ToolCardTile key={tool.id} tool={tool} />
        ))}
      </div>
    </section>
  );
}

