import { useState } from "react";
import "./wm-architecture-canvas.css";

export default function DashboardArchitectureCanvas() {
  const [selectedSource, setSelectedSource] = useState<string | null>(null);
  const [routes, setRoutes] = useState<Record<string, string[]>>({});

  const sources = ["S1", "S2", "S3", "S4"];
  const displays = ["D1", "D2", "D3", "D4", "D5", "D6"];

  function toggleRoute(displayId: string) {
    if (!selectedSource) return;

    setRoutes((prev) => {
      const current = prev[selectedSource] || [];

      if (current.includes(displayId)) {
        return {
          ...prev,
          [selectedSource]: current.filter(d => d !== displayId)
        };
      }

      return {
        ...prev,
        [selectedSource]: [...current, displayId]
      };
    });
  }

  return (
    <div className="wm-arch">

      <div className="wm-chain">
        <div className="wm-node core">TX</div>
        <div className="wm-node core">Switch</div>
        <div className="wm-node core">RX</div>
      </div>

      <div className="wm-grid">

        {/* SOURCES */}
        <div className="wm-col">
          <div className="wm-label">Sources</div>
          {sources.map(s => (
            <div
              key={s}
              className={`wm-node ${selectedSource === s ? "active" : ""}`}
              onClick={() => setSelectedSource(s)}
            >
              {s}
            </div>
          ))}
        </div>

        {/* ROUTING LINES */}
        <div className="wm-lines">
          {Object.entries(routes).map(([source, targets]) =>
            targets.map(target => (
              <div key={`${source}-${target}`} className="wm-line">
                {source} → {target}
              </div>
            ))
          )}
        </div>

        {/* DISPLAYS */}
        <div className="wm-col">
          <div className="wm-label">Displays</div>
          {displays.map(d => {
            const active = selectedSource && routes[selectedSource]?.includes(d);

            return (
              <div
                key={d}
                className={`wm-node ${active ? "active" : ""}`}
                onClick={() => toggleRoute(d)}
              >
                {d}
              </div>
            );
          })}
        </div>

      </div>

    </div>
  );
}