.wm-arch__header {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 12px;
}

.wm-arch__controls button {
  padding: 4px 10px;
  border-radius: 8px;
  border: 1px solid rgba(255,255,255,0.1);
  background: transparent;
  cursor: pointer;
  font-size: 12px;
}

.wm-arch__controls button.active {
  background: rgba(59,130,246,0.2);
  border-color: rgba(59,130,246,0.4);
}

.wm-arch__status {
  margin-left: auto;
  font-size: 12px;
  padding: 4px 10px;
  border-radius: 8px;
}

.wm-arch__status--ok {
  background: rgba(34,197,94,0.15);
  color: #4ade80;
}

.wm-arch__status--warn {
  background: rgba(245,158,11,0.15);
  color: #fbbf24;
}

.wm-arch__status--error {
  background: rgba(239,68,68,0.15);
  color: #f87171;
}

.wm-link {
  font-size: 11px;
  opacity: 0.8;
  margin-bottom: 4px;
}