import { useMemo, useState } from "react";
import "./wm-architecture-canvas.css";

type Mode = "avoip" | "matrix";

type Props = {
  title?: string;
  sourceCount?: number;
  displayCount?: number;
  distanceLabel?: string;
};

export default function DashboardArchitectureCanvas({
  title = "System Architecture",
  sourceCount = 4,
  displayCount = 6,
  distanceLabel = "50m",
}: Props) {
  const [mode, setMode] = useState<Mode>("avoip");
  const [routes, setRoutes] = useState<Record<number, number[]>>({});
  const [selectedSource, setSelectedSource] = useState<number | null>(null);

  const sources = useMemo(
    () => Array.from({ length: sourceCount }, (_, i) => i),
    [sourceCount],
  );

  const displays = useMemo(
    () => Array.from({ length: displayCount }, (_, i) => i),
    [displayCount],
  );

  function toggleRoute(source: number, display: number) {
    setRoutes((prev) => {
      const current = prev[source] || [];

      if (current.includes(display)) {
        return {
          ...prev,
          [source]: current.filter((d) => d !== display),
        };
      }

      // Matrix = only one output allowed
      if (mode === "matrix") {
        return { ...prev, [source]: [display] };
      }

      return {
        ...prev,
        [source]: [...current, display],
      };
    });
  }

  // 🔍 Validation logic
  const validation = useMemo(() => {
    const totalLinks = Object.values(routes).reduce(
      (acc, arr) => acc + arr.length,
      0,
    );

    if (totalLinks === 0) {
      return { state: "idle", message: "No routing configured" };
    }

    if (mode === "matrix" && totalLinks > sourceCount) {
      return { state: "error", message: "Matrix over-subscribed" };
    }

    if (parseInt(distanceLabel) > 70) {
      return { state: "warn", message: "Distance may require extender" };
    }

    return { state: "ok", message: "System valid" };
  }, [routes, mode, sourceCount, distanceLabel]);

  return (
    <div className="wm-arch">
      <div className="wm-arch__header">
        <h3>{title}</h3>

        <div className="wm-arch__controls">
          <button
            className={mode === "avoip" ? "active" : ""}
            onClick={() => setMode("avoip")}
          >
            AVoIP
          </button>

          <button
            className={mode === "matrix" ? "active" : ""}
            onClick={() => setMode("matrix")}
          >
            Matrix
          </button>
        </div>

        <div className={`wm-arch__status wm-arch__status--${validation.state}`}>
          {validation.message}
        </div>
      </div>

      <div className="wm-arch__grid">
        {/* SOURCES */}
        <div className="wm-arch__column">
          <div className="wm-arch__column-title">Sources</div>
          {sources.map((s) => (
            <div
              key={s}
              className={`wm-node ${selectedSource === s ? "active" : ""}`}
              onClick={() => setSelectedSource(s)}
            >
              S{s + 1}
            </div>
          ))}
        </div>

        {/* ROUTING */}
        <div className="wm-arch__column wm-arch__routing">
          {sources.map((s) =>
            (routes[s] || []).map((d) => (
              <div key={`${s}-${d}`} className="wm-link">
                S{s + 1} → D{d + 1}
              </div>
            )),
          )}
        </div>

        {/* DISPLAYS */}
        <div className="wm-arch__column">
          <div className="wm-arch__column-title">Displays</div>
          {displays.map((d) => (
            <div
              key={d}
              className="wm-node"
              onClick={() => {
                if (selectedSource !== null) {
                  toggleRoute(selectedSource, d);
                }
              }}
            >
              D{d + 1}
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}