:root {
  --wmx-bg: #09111e;
  --wmx-bg-2: #0b1524;
  --wmx-panel: #0f1a2d;
  --wmx-panel-2: #132238;
  --wmx-panel-3: #152844;
  --wmx-line: rgba(125, 156, 210, 0.18);
  --wmx-line-strong: rgba(120, 180, 255, 0.34);
  --wmx-text: #eef4ff;
  --wmx-muted: rgba(216, 227, 245, 0.72);
  --wmx-subtle: rgba(216, 227, 245, 0.56);
  --wmx-blue: #4aa3ff;
  --wmx-blue-2: #6cc0ff;
  --wmx-green: #4ade80;
  --wmx-amber: #fbbf24;
  --wmx-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
  --wmx-glow: 0 0 0 1px rgba(74, 163, 255, 0.15), 0 0 22px rgba(74, 163, 255, 0.08);
}

.wmx-app {
  color: var(--wmx-text);
  background:
    radial-gradient(circle at top center, rgba(74, 163, 255, 0.1), transparent 28%),
    linear-gradient(180deg, #08111d 0%, #0a1220 100%);
  min-height: 100%;
  border-radius: 18px;
}

.wmx-topbar {
  display: grid;
  grid-template-columns: 220px minmax(0, 1fr) 120px;
  align-items: center;
  gap: 12px;
  padding: 14px 18px;
  border: 1px solid var(--wmx-line);
  border-radius: 18px;
  background: linear-gradient(180deg, rgba(19, 33, 57, 0.96), rgba(11, 21, 38, 0.98));
  box-shadow: var(--wmx-shadow);
  margin-bottom: 14px;
}

.wmx-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
}

.wmx-brand-mark {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: var(--wmx-blue-2);
  border: 1px solid var(--wmx-line-strong);
  background: rgba(74, 163, 255, 0.1);
}

.wmx-brand-name {
  font-size: 1.7rem;
  font-weight: 700;
  letter-spacing: 0.01em;
}

.wmx-topbar-meta {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}

.wmx-topbar-pill {
  min-height: 56px;
  border: 1px solid var(--wmx-line);
  border-radius: 14px;
  padding: 10px 12px;
  background: linear-gradient(180deg, rgba(14, 25, 44, 0.96), rgba(10, 18, 31, 0.98));
  display: grid;
  align-content: center;
  gap: 4px;
}

.wmx-topbar-label {
  color: var(--wmx-subtle);
  font-size: 0.82rem;
}

.wmx-topbar-pill strong {
  font-size: 1rem;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wmx-topbar-tools {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
}

.wmx-icon-btn {
  width: 38px;
  height: 38px;
  border-radius: 999px;
  border: 1px solid var(--wmx-line);
  background: rgba(255, 255, 255, 0.04);
  color: var(--wmx-text);
  cursor: pointer;
}

.wmx-layout {
  display: grid;
  grid-template-columns: 210px minmax(0, 1fr) 300px;
  gap: 14px;
  align-items: start;
}

.wmx-sidebar,
.wmx-rightbar {
  display: grid;
  gap: 12px;
}

.wmx-sidebar {
  padding: 6px 0;
}

.wmx-nav-item {
  display: grid;
  grid-template-columns: 24px 1fr;
  align-items: center;
  gap: 12px;
  min-height: 62px;
  padding: 0 14px;
  border: 1px solid var(--wmx-line);
  border-radius: 0 16px 16px 0;
  background: linear-gradient(180deg, rgba(19, 32, 54, 0.96), rgba(12, 22, 39, 0.98));
  color: var(--wmx-text);
  text-align: left;
  cursor: pointer;
  box-shadow: var(--wmx-shadow);
}

.wmx-nav-item.is-active {
  border-color: var(--wmx-line-strong);
  background: linear-gradient(180deg, rgba(21, 41, 73, 0.98), rgba(14, 28, 50, 1));
  box-shadow: var(--wmx-glow), var(--wmx-shadow);
}

.wmx-nav-icon {
  width: 18px;
  height: 18px;
  border-radius: 4px;
  border: 1px solid var(--wmx-line-strong);
  background:
    linear-gradient(90deg, rgba(74, 163, 255, 0.14), rgba(74, 163, 255, 0.02)),
    rgba(255, 255, 255, 0.03);
}

.wmx-nav-text {
  font-weight: 600;
}

.wmx-main {
  display: grid;
  gap: 14px;
}

.wmx-section {
  display: grid;
  gap: 12px;
}

.wmx-section-header h1,
.wmx-section-header h2 {
  margin: 0;
  font-size: 2rem;
  font-weight: 700;
  letter-spacing: 0.01em;
}

.wmx-section-header p {
  margin: 6px 0 0;
  color: var(--wmx-muted);
  font-size: 1rem;
}

.wmx-card-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}

.wmx-config-card {
  border: 1px solid var(--wmx-line);
  border-radius: 18px;
  padding: 18px;
  background: linear-gradient(180deg, rgba(18, 30, 52, 0.96), rgba(11, 21, 39, 1));
  box-shadow: var(--wmx-shadow);
  min-height: 250px;
  display: grid;
  align-content: start;
  gap: 10px;
}

.wmx-config-card.is-selected {
  border-color: var(--wmx-line-strong);
  box-shadow: var(--wmx-glow), var(--wmx-shadow);
}

.wmx-config-visual {
  height: 92px;
  display: grid;
  place-items: center;
}

.wmx-config-title {
  font-size: 1.7rem;
  font-weight: 700;
  text-align: center;
}

.wmx-config-subtitle {
  font-size: 1rem;
  color: var(--wmx-muted);
  text-align: center;
}

.wmx-config-copy {
  color: var(--wmx-subtle);
  line-height: 1.45;
  min-height: 64px;
  text-align: center;
}

.wmx-config-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  justify-content: center;
}

.wmx-config-stats span {
  border: 1px solid var(--wmx-line);
  border-radius: 999px;
  padding: 5px 10px;
  color: var(--wmx-muted);
  font-size: 0.82rem;
  background: rgba(255, 255, 255, 0.03);
}

.wmx-recommended-bar {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 1.05rem;
  padding: 0 4px;
}

.wmx-recommended-label {
  color: var(--wmx-text);
  font-weight: 700;
}

.wmx-recommended-bar strong {
  color: var(--wmx-blue-2);
}

.wmx-architecture-panel,
.wmx-right-panel,
.wmx-data-panel,
.wmx-loading-card {
  border: 1px solid var(--wmx-line);
  border-radius: 18px;
  background: linear-gradient(180deg, rgba(15, 26, 45, 0.98), rgba(10, 18, 31, 1));
  box-shadow: var(--wmx-shadow);
}

.wmx-architecture-panel {
  padding: 0;
  overflow: hidden;
}

.wmx-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 18px;
  border-bottom: 1px solid var(--wmx-line);
}

.wmx-panel-title {
  font-size: 1.45rem;
  font-weight: 700;
}

.wmx-panel-dots {
  color: var(--wmx-subtle);
  letter-spacing: 0.14em;
}

.wmx-architecture-grid {
  padding: 18px;
  display: grid;
  grid-template-columns: 220px minmax(300px, 1fr) 220px;
  gap: 16px;
  min-height: 420px;
  background:
    linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px),
    linear-gradient(180deg, rgba(8, 16, 28, 0.94), rgba(8, 16, 28, 1));
  background-size: 28px 28px, 28px 28px, auto;
}

.wmx-column {
  display: grid;
  align-content: start;
  gap: 12px;
}

.wmx-node-label {
  min-height: 38px;
  border: 1px solid var(--wmx-line-strong);
  border-radius: 12px;
  display: grid;
  place-items: center;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.03);
}

.wmx-node-stack,
.wmx-core-stack {
  display: grid;
  gap: 12px;
}

.wmx-node-card,
.wmx-core-card,
.wmx-display-card {
  border: 1px solid var(--wmx-line);
  border-radius: 14px;
  background: linear-gradient(180deg, rgba(21, 35, 58, 0.96), rgba(13, 23, 41, 1));
  padding: 12px;
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.02);
}

.wmx-core-card {
  display: grid;
  grid-template-columns: 110px 1fr;
  gap: 14px;
  align-items: center;
  min-height: 96px;
}

.wmx-core-copy {
  display: grid;
  gap: 4px;
}

.wmx-core-copy strong {
  font-size: 1rem;
}

.wmx-core-copy span {
  color: var(--wmx-muted);
  line-height: 1.35;
}

.wmx-display-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.wmx-screen {
  width: 100%;
  aspect-ratio: 16 / 10;
  border-radius: 10px;
  border: 1px solid rgba(132, 182, 255, 0.35);
  background:
    radial-gradient(circle at 50% 35%, rgba(125, 184, 255, 0.28), transparent 45%),
    linear-gradient(180deg, #1d3b69 0%, #203352 60%, #12223b 100%);
  box-shadow: inset 0 0 20px rgba(103, 177, 255, 0.15);
}

.wmx-device {
  position: relative;
  width: 100%;
  height: 54px;
  border-radius: 10px;
  border: 1px solid rgba(160, 186, 226, 0.18);
  background:
    linear-gradient(180deg, rgba(63, 77, 99, 0.75), rgba(28, 38, 52, 0.98)),
    linear-gradient(90deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01));
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.08),
    inset 0 -1px 0 rgba(0,0,0,0.35),
    0 10px 22px rgba(0,0,0,0.25);
}

.wmx-device--large {
  width: 78%;
  height: 62px;
}

.wmx-device--core {
  height: 62px;
}

.wmx-device-lights {
  position: absolute;
  top: 50%;
  left: 12px;
  transform: translateY(-50%);
  display: flex;
  gap: 6px;
}

.wmx-device-lights span {
  width: 9px;
  height: 9px;
  border-radius: 2px;
  background: linear-gradient(180deg, #4ade80, #f59e0b, #ef4444);
  opacity: 0.88;
}

.wmx-device-lines {
  position: absolute;
  right: 12px;
  top: 50%;
  transform: translateY(-50%);
  width: 46%;
  height: 16px;
  border-radius: 4px;
  background:
    repeating-linear-gradient(
      90deg,
      rgba(190, 209, 238, 0.22) 0,
      rgba(190, 209, 238, 0.22) 9px,
      transparent 9px,
      transparent 15px
    );
}

.wmx-link-summary {
  border-top: 1px solid var(--wmx-line);
  padding: 16px 18px 12px;
  display: grid;
  gap: 10px;
}

.wmx-link-summary-title {
  font-size: 1rem;
  font-weight: 700;
}

.wmx-link-list {
  display: grid;
  gap: 8px;
}

.wmx-link-item {
  display: grid;
  grid-template-columns: 180px 20px 1fr;
  gap: 8px;
  color: var(--wmx-muted);
  font-size: 0.92rem;
}

.wmx-link-item strong {
  color: var(--wmx-text);
}

.wmx-panel-action {
  padding: 8px 18px 18px;
  display: flex;
  justify-content: center;
}

.wmx-primary-btn {
  min-width: 320px;
  min-height: 50px;
  border-radius: 12px;
  border: 1px solid rgba(111, 173, 255, 0.5);
  background: linear-gradient(180deg, #225db8 0%, #1a4590 100%);
  color: var(--wmx-text);
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 10px 24px rgba(28, 83, 163, 0.35);
}

.wmx-right-panel,
.wmx-data-panel,
.wmx-loading-card {
  padding: 16px;
}

.wmx-right-title {
  font-size: 1.5rem;
  font-weight: 700;
  margin-bottom: 14px;
}

.wmx-right-subtitle {
  color: var(--wmx-text);
  font-weight: 700;
  margin-bottom: 12px;
}

.wmx-product-list,
.wmx-alert-list,
.wmx-proposal-list {
  display: grid;
  gap: 12px;
}

.wmx-product-item {
  display: grid;
  grid-template-columns: 90px 1fr;
  gap: 12px;
  align-items: center;
  border: 1px solid var(--wmx-line);
  border-radius: 14px;
  padding: 12px;
  background: rgba(255, 255, 255, 0.025);
}

.wmx-product-thumb {
  display: grid;
  place-items: center;
}

.wmx-product-copy {
  display: grid;
  gap: 4px;
}

.wmx-product-copy strong {
  font-size: 1rem;
}

.wmx-product-copy span {
  color: var(--wmx-muted);
  line-height: 1.35;
}

.wmx-alert-item {
  display: grid;
  grid-template-columns: 18px 1fr;
  gap: 10px;
  align-items: start;
  border-top: 1px solid var(--wmx-line);
  padding-top: 12px;
}

.wmx-alert-item:first-child {
  border-top: 0;
  padding-top: 0;
}

.wmx-alert-dot {
  width: 12px;
  height: 12px;
  border-radius: 999px;
  margin-top: 4px;
}

.wmx-alert-dot--good {
  background: var(--wmx-green);
  box-shadow: 0 0 12px rgba(74, 222, 128, 0.45);
}

.wmx-alert-dot--warn {
  background: var(--wmx-amber);
  box-shadow: 0 0 12px rgba(251, 191, 36, 0.45);
}

.wmx-alert-dot--info {
  background: var(--wmx-blue);
  box-shadow: 0 0 12px rgba(74, 163, 255, 0.45);
}

.wmx-alert-copy {
  display: grid;
  gap: 3px;
}

.wmx-alert-copy strong {
  font-size: 1rem;
}

.wmx-alert-copy span {
  color: var(--wmx-muted);
  line-height: 1.35;
}

.wmx-summary-metric {
  display: grid;
  gap: 4px;
  border-top: 1px solid var(--wmx-line);
  padding-top: 12px;
  margin-top: 12px;
}

.wmx-summary-metric:first-of-type {
  border-top: 0;
  padding-top: 0;
  margin-top: 0;
}

.wmx-summary-metric span {
  color: var(--wmx-subtle);
  font-size: 0.88rem;
}

.wmx-summary-metric strong {
  font-size: 1.2rem;
}

.wmx-table {
  width: 100%;
  border-collapse: collapse;
}

.wmx-table th,
.wmx-table td {
  text-align: left;
  padding: 12px 10px;
  border-top: 1px solid var(--wmx-line);
}

.wmx-table th {
  color: var(--wmx-subtle);
  font-weight: 600;
}

.wmx-proposal-title {
  font-size: 1.35rem;
  font-weight: 700;
  margin-bottom: 14px;
}

.wmx-proposal-card {
  border: 1px solid var(--wmx-line);
  border-radius: 14px;
  padding: 14px;
  background: rgba(255, 255, 255, 0.025);
}

.wmx-proposal-card h3 {
  margin: 0 0 8px;
  font-size: 1.05rem;
}

.wmx-proposal-card p {
  margin: 0;
  color: var(--wmx-muted);
  line-height: 1.5;
}

.wmx-loading-card {
  min-height: 240px;
  display: grid;
  align-content: center;
  justify-items: center;
  gap: 10px;
}

.wmx-loading-title {
  font-size: 1.3rem;
  font-weight: 700;
}

.wmx-loading-copy {
  color: var(--wmx-muted);
}

@media (max-width: 1400px) {
  .wmx-layout {
    grid-template-columns: 190px minmax(0, 1fr);
  }

  .wmx-rightbar {
    grid-column: 1 / -1;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    display: grid;
  }
}

@media (max-width: 1180px) {
  .wmx-topbar {
    grid-template-columns: 1fr;
  }

  .wmx-topbar-meta {
    grid-template-columns: 1fr;
  }

  .wmx-layout {
    grid-template-columns: 1fr;
  }

  .wmx-sidebar {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    display: grid;
  }

  .wmx-nav-item {
    border-radius: 14px;
  }

  .wmx-card-row {
    grid-template-columns: 1fr;
  }

  .wmx-architecture-grid {
    grid-template-columns: 1fr;
    min-height: auto;
  }

  .wmx-display-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .wmx-rightbar {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 720px) {
  .wmx-sidebar {
    grid-template-columns: 1fr 1fr;
  }

  .wmx-link-item {
    grid-template-columns: 1fr;
  }

  .wmx-product-item {
    grid-template-columns: 1fr;
  }

  .wmx-display-grid {
    grid-template-columns: 1fr 1fr;
  }

  .wmx-primary-btn {
    min-width: 100%;
  }
}

.wm-input-dark,
.wm-select-dark,
.wm-textarea-dark {
  width: 100%;
  border-radius: 12px;
  border: 1px solid var(--wmx-line);
  background: rgba(255, 255, 255, 0.03);
  color: var(--wmx-text);
  padding: 12px 14px;
  font: inherit;
  box-sizing: border-box;
}

.wm-textarea-dark {
  min-height: 120px;
  resize: vertical;
}

.wm-input-dark:focus,
.wm-select-dark:focus,
.wm-textarea-dark:focus {
  outline: none;
  border-color: var(--wmx-line-strong);
  box-shadow: var(--wmx-glow);
}

.wmx-rightbar:empty {
  display: none;
}
.wmx-nav-item.is-disabled {
  opacity: 0.58;
  cursor: default;
}

.wmx-nav-item:disabled {
  pointer-events: none;
}