import { useEffect, useMemo, useState } from "react";
import { useNavigate } from "react-router-dom";
import { WM_ROUTES } from "@/core/wingman/routeMap";
import { loadActiveProjectSnapshot } from "@/app/logic/wingmanProjectState";
import { buildVideoWallPersistedProject, loadActivePersistedProject, upsertPersistedProject } from "@/app/logic/wingmanProjectPersistence";
import { buildWingmanSalesIntelligence } from "@/app/logic/wingmanSalesIntelligence";

type WallView = "setup" | "visual" | "bom" | "sales";
type WallType = "LCD Video Wall" | "LED Wall";
type DriveMode = "Single canvas" | "Multiview canvas" | "Addressed panels";

function VisualCanvas({
  rows,
  cols,
  wallType,
}: {
  rows: number;
  cols: number;
  wallType: WallType;
}) {
  const total = Math.max(1, rows * cols);

  return (
    <div className="wm-surface-card--soft" style={{ padding: 14, display: "grid", gap: 12 }}>
      <div style={{ fontSize: 13, fontWeight: 700, color: "#ffffff" }}>Visual preview</div>

      <div
        style={{
          display: "grid",
          gridTemplateColumns: `repeat(${cols}, minmax(0, 1fr))`,
          gap: wallType === "LCD Video Wall" ? 6 : 2,
          background: "rgba(2,8,23,0.55)",
          borderRadius: 16,
          padding: 12,
          minHeight: 260,
        }}
      >
        {Array.from({ length: total }).map((_, index) => (
          <div
            key={index}
            style={{
              aspectRatio: "16 / 9",
              borderRadius: wallType === "LCD Video Wall" ? 8 : 3,
              border:
                wallType === "LCD Video Wall"
                  ? "2px solid rgba(148,163,184,0.18)"
                  : "1px solid rgba(56,189,248,0.18)",
              background:
                wallType === "LCD Video Wall"
                  ? "linear-gradient(180deg, rgba(30,41,59,0.92), rgba(15,23,42,0.92))"
                  : "linear-gradient(180deg, rgba(8,47,73,0.92), rgba(15,23,42,0.92))",
              display: "grid",
              placeItems: "center",
              color: "rgba(226,232,240,0.60)",
              fontSize: 11,
              fontWeight: 700,
            }}
          >
            {index + 1}
          </div>
        ))}
      </div>
    </div>
  );
}

export default function VideoWallPlannerRebuild() {
  const navigate = useNavigate();
  const snapshot = useMemo(() => loadActiveProjectSnapshot(), []);
  const persistedProject = useMemo(() => loadActivePersistedProject(), []);

  const [view, setView] = useState<WallView>("setup");
  const [wallType, setWallType] = useState<WallType>("LCD Video Wall");
  const [rows, setRows] = useState("2");
  const [cols, setCols] = useState("2");
  const [sourceCount, setSourceCount] = useState("1");
  const [bezelMm, setBezelMm] = useState("4");
  const [driveMode, setDriveMode] = useState<DriveMode>("Single canvas");
  const [projectNotes, setProjectNotes] = useState("");
  const [savedNotice, setSavedNotice] = useState("");

  useEffect(() => {
    if (persistedProject?.videoWall) {
      setWallType(persistedProject.videoWall.wallType || "LCD Video Wall");
      setRows(String(Math.max(1, persistedProject.videoWall.rows || 1)));
      setCols(String(Math.max(1, persistedProject.videoWall.cols || 1)));
      setSourceCount(String(Math.max(1, persistedProject.videoWall.sourceCount || 1)));
      setBezelMm(String(Math.max(0, persistedProject.videoWall.bezelMm || 0)));
      setDriveMode(persistedProject.videoWall.driveMode || "Single canvas");
      setProjectNotes(persistedProject.videoWall.notes || "");
      return;
    }

    if (!snapshot) return;
    if (!snapshot.project.discovery.videoWall) return;

    const displays = Math.max(1, snapshot.project.discovery.displays || 1);
    const suggestedRows = Math.max(1, Math.round(Math.sqrt(displays)));
    const suggestedCols = Math.max(1, Math.ceil(displays / suggestedRows));

    setRows(String(suggestedRows));
    setCols(String(suggestedCols));
    setSourceCount(String(Math.max(1, snapshot.project.discovery.sources || 1)));

    if (snapshot.project.discovery.advancedMultiview) {
      setDriveMode("Multiview canvas");
    } else {
      setDriveMode("Single canvas");
    }

    setWallType("LCD Video Wall");

    const notes: string[] = [];
    notes.push(`Discovery recommends: ${snapshot.decision.architecture}.`);
    if (snapshot.project.discovery.distanceM) {
      notes.push(`Longest signal distance: ${snapshot.project.discovery.distanceM}m.`);
    }
    if (snapshot.project.discovery.hybridMeeting) {
      notes.push("Hybrid meeting workflow is in scope.");
    }
    if (snapshot.project.discovery.advancedMultiview) {
      notes.push("Advanced multiview behaviour is likely required.");
    }

    setProjectNotes(notes.join(" "));
  }, [snapshot, persistedProject]);

  const salesIntelligence = useMemo(() => {
    return snapshot ? buildWingmanSalesIntelligence(snapshot) : null;
  }, [snapshot]);

  const derived = useMemo(() => {
    const r = Math.max(1, Number(rows) || 1);
    const c = Math.max(1, Number(cols) || 1);
    const displays = r * c;
    const sources = Math.max(1, Number(sourceCount) || 1);
    const bezel = Math.max(0, Number(bezelMm) || 0);

    const tier =
      wallType === "LED Wall"
        ? displays >= 9 ? "Gold" : "Silver"
        : displays >= 9 ? "Silver" : "Bronze";

    const transport =
      wallType === "LED Wall"
        ? "Processor-led LED workflow with defined canvas output."
        : displays >= 4
          ? "Video wall processor or AVoIP-led wall transport."
          : "Compact wall transport strategy is likely enough.";

    const recommendedProduct =
      wallType === "LED Wall"
        ? "MX-0812-SCL"
        : driveMode === "Single canvas" && displays <= 6 && sources <= 2
          ? "SW-0206-VW"
          : "MX-0812-SCL";

    const recommendedApproach =
      wallType === "LED Wall"
        ? "Advanced processor-led LED workflow."
        : recommendedProduct === "SW-0206-VW"
          ? "Dedicated non-AVoIP video wall processor path."
          : "Advanced wall processing path with stronger flexibility.";

    const why =
      wallType === "LED Wall"
        ? [
            "LED walls are canvas-led and typically justify processor-centric design.",
            "This approach is better for custom resolutions and larger visual impact spaces.",
            "Flexible scaling and layering is more valuable in LED workflows.",
          ]
        : recommendedProduct === "SW-0206-VW"
          ? [
              "The wall appears simple enough for a dedicated processor path.",
              "This keeps cost and design complexity under better control.",
              "A non-AVoIP wall option should be considered first for fixed layouts.",
            ]
          : [
              "The wall size or behaviour suggests a more advanced processing route.",
              "This gives more flexibility for layout, scaling and future expansion.",
              "It is a better fit where multiview or more complex source behaviour is expected.",
            ];

    const confirmBeforeQuote = [
      "Confirm exact wall layout and display orientation.",
      "Confirm whether content is single-canvas, multiview, or independently addressed.",
      wallType === "LED Wall"
        ? "Confirm LED processor and target output resolution."
        : "Confirm whether a dedicated processor path is sufficient before moving to a more complex architecture.",
    ];

    if (sources >= 3) {
      confirmBeforeQuote.push("Confirm how multiple sources should appear on the wall.");
    }

    if (snapshot?.project.discovery.distanceM && snapshot.project.discovery.distanceM > 30) {
      confirmBeforeQuote.push("Validate transport method and infrastructure because distance is material.");
    }

    const products =
      wallType === "LED Wall"
        ? [
            "LED processor / controller",
            "Optional multiview or decoder source layer",
            "Control and infrastructure accessories",
          ]
        : recommendedProduct === "SW-0206-VW"
          ? [
              "SW-0206-VW",
              "Source transport layer",
              "Display connectivity and accessories",
            ]
          : [
              "MX-0812-SCL",
              "Wall control / visual distribution strategy",
              "Display connectivity and accessories",
            ];

    const sales =
      wallType === "LED Wall"
        ? [
            "Best where the customer is buying impact and scale.",
            "Allows clearer upsell into processor and control options.",
            "Good for premium spaces and statement installations.",
          ]
        : recommendedProduct === "SW-0206-VW"
          ? [
              "Good when the customer needs a practical wall without unnecessary architecture overhead.",
              "Helps position a simpler, lower-risk, lower-cost wall solution.",
              "Useful where layouts are mostly fixed and the workflow is straightforward.",
            ]
          : [
              "Useful where the customer needs stronger flexibility or future growth.",
              "Supports a better conversation around scaling, layout control and expansion.",
              "Good for customers who want the wall to do more than display a fixed canvas.",
            ];

    return {
      rows: r,
      cols: c,
      displays,
      sources,
      bezel,
      tier,
      transport,
      products,
      sales,
      recommendedProduct,
      recommendedApproach,
      why,
      confirmBeforeQuote,
    };
  }, [wallType, rows, cols, sourceCount, bezelMm, driveMode, snapshot]);


  function handleSaveWallToProject() {
    const persisted = buildVideoWallPersistedProject({
      snapshot,
      wallType,
      rows: Math.max(1, Number(rows) || 1),
      cols: Math.max(1, Number(cols) || 1),
      sourceCount: Math.max(1, Number(sourceCount) || 1),
      bezelMm: Math.max(0, Number(bezelMm) || 0),
      driveMode,
      notes: projectNotes,
    });

    upsertPersistedProject(persisted);
    setSavedNotice(`Saved video wall to project: ${persisted.name}`);
    window.setTimeout(() => setSavedNotice(""), 1800);
  }
  const activeStep =
    view === "setup" ? 1 :
    view === "visual" ? 2 :
    3;

  return (
    <div className="wm-fit-page wmu-adopt">
      <section className="wm-vw-top-strip">
        <div className="wm-vw-top-strip__hero">
          <div className="wm-page-kicker" style={{ marginBottom: 4 }}>Video Wall Planner</div>
          <div className="wm-vw-top-strip__title">Design the wall first, then open the right detail</div>
          <div className="wm-vw-top-strip__copy">
            Start with setup, then switch to visual, BOM, or sales.
          </div>
        </div>

        <div className="wm-vw-top-strip__guide">
          <div className="wm-vw-top-strip__guide-title">Current priority</div>

          <div className={`wm-vw-top-strip__step${activeStep === 1 ? " wm-vw-top-strip__step--active" : ""}`}>
            <span className="wm-vw-top-strip__step-badge">1</span>
            <span className="wm-vw-top-strip__step-text">Define wall</span>
          </div>

          <div className={`wm-vw-top-strip__step${activeStep === 2 ? " wm-vw-top-strip__step--active" : ""}`}>
            <span className="wm-vw-top-strip__step-badge">2</span>
            <span className="wm-vw-top-strip__step-text">Check visual</span>
          </div>

          <div className={`wm-vw-top-strip__step${activeStep === 3 ? " wm-vw-top-strip__step--active" : ""}`}>
            <span className="wm-vw-top-strip__step-badge">3</span>
            <span className="wm-vw-top-strip__step-text">Open delivery view</span>
          </div>
        </div>
      </section>

      <section
        className="wm-surface-card"
        style={{
          padding: 16,
          display: "grid",
          gap: 12,
          marginBottom: 14,
          border: "1px solid rgba(96,165,250,0.22)",
          background: "linear-gradient(180deg, rgba(15,23,42,0.88), rgba(15,23,42,0.72))",
        }}
      >
        <div style={{ fontSize: 11, fontWeight: 800, letterSpacing: "0.10em", textTransform: "uppercase", color: "#93c5fd" }}>
          Recommended approach
        </div>

        <div style={{ display: "grid", gridTemplateColumns: "1.1fr 0.9fr", gap: 14 }}>
          <div style={{ display: "grid", gap: 10 }}>
            <div style={{ fontSize: 24, fontWeight: 900, color: "#ffffff" }}>
              {derived.recommendedProduct}
            </div>
            <div style={{ color: "rgba(226,232,240,0.84)", lineHeight: 1.5 }}>
              {derived.recommendedApproach}
            </div>
            <div style={{ display: "grid", gap: 8 }}>
              {derived.why.map((item) => (
                <div
                  key={item}
                  style={{
                    padding: "10px 12px",
                    borderRadius: 12,
                    background: "rgba(255,255,255,0.04)",
                    border: "1px solid rgba(255,255,255,0.06)",
                  }}
                >
                  {item}
                </div>
              ))}
            </div>
          </div>

          <div style={{ display: "grid", gap: 10 }}>
            <div
              style={{
                padding: 12,
                borderRadius: 14,
                background: "rgba(255,255,255,0.04)",
                border: "1px solid rgba(255,255,255,0.06)",
              }}
            >
              <div style={{ fontSize: 12, fontWeight: 700, color: "#ffffff", marginBottom: 8 }}>
                Confirm before quote
              </div>
              <div style={{ display: "grid", gap: 8 }}>
                {derived.confirmBeforeQuote.map((item) => (
                  <div key={item} style={{ color: "rgba(226,232,240,0.82)", lineHeight: 1.45 }}>
                    ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚Â¢ {item}
                  </div>
                ))}
              </div>
            </div>

            {snapshot ? (
              <div
                style={{
                  padding: 12,
                  borderRadius: 14,
                  background: "rgba(255,255,255,0.04)",
                  border: "1px solid rgba(255,255,255,0.06)",
                }}
              >
                <div style={{ fontSize: 12, fontWeight: 700, color: "#ffffff", marginBottom: 8 }}>
                  Discovery link
                </div>
                <div style={{ color: "rgba(226,232,240,0.82)", lineHeight: 1.45 }}>
                  {snapshot.project.name || "Active project"} ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â· {snapshot.decision.architecture}
                </div>
              </div>
            ) : null}
          </div>
        </div>
            </section>

      {salesIntelligence ? (
        <section
          className="wm-surface-card"
          style={{
            padding: 16,
            display: "grid",
            gap: 12,
            marginBottom: 14,
          }}
        >
          <div style={{ fontSize: 11, fontWeight: 800, letterSpacing: "0.10em", textTransform: "uppercase", color: "#93c5fd" }}>
            Commercial positioning
          </div>

          <div className="wm-grid-2" style={{ gridTemplateColumns: "repeat(2, minmax(0, 1fr))" }}>
            <article className="wm-product-card">
              <div className="wm-product-card__sku">Why WyreStorm</div>
              <div className="wm-product-card__copy" style={{ marginBottom: 0 }}>
                {salesIntelligence.whyWyreStorm}
              </div>
            </article>

            <article className="wm-product-card">
              <div className="wm-product-card__sku">Why this wall path</div>
              <div className="wm-product-card__copy" style={{ marginBottom: 0 }}>
                {salesIntelligence.whyThisArchitecture}
              </div>
            </article>
          </div>

          <div className="wm-grid-2" style={{ gridTemplateColumns: "repeat(2, minmax(0, 1fr))" }}>
            <article className="wm-product-card">
              <div className="wm-product-card__sku">Upsell prompts</div>
              <div style={{ display: "grid", gap: 8 }}>
                {salesIntelligence.upsellPrompts.map((item) => (
                  <div key={item} className="wm-product-card__copy" style={{ marginBottom: 0 }}>
                    â€¢ {item}
                  </div>
                ))}
              </div>
            </article>

            <article className="wm-product-card">
              <div className="wm-product-card__sku">Risk prompts</div>
              <div style={{ display: "grid", gap: 8 }}>
                {salesIntelligence.riskPrompts.map((item) => (
                  <div key={item} className="wm-product-card__copy" style={{ marginBottom: 0 }}>
                    â€¢ {item}
                  </div>
                ))}
              </div>
            </article>
          </div>
        </section>
      ) : null}

      <section className="wm-fit-page__body wm-grid-2">
        <aside
          className="wm-surface-card"
          style={{
            padding: 16,
            display: "grid",
            gap: 12,
            alignSelf: "start",
          }}
        >
          <div>
            <div className="wm-section-title">Wall setup</div>
            <div className="wm-section-copy">Capture only the key design inputs first.</div>
          </div>

          <div className="wm-surface-card--soft" style={{ padding: 12 }}>
            <div style={{ fontSize: 12, fontWeight: 700, color: "#ffffff", marginBottom: 7 }}>Wall type</div>
            <div className="wm-toolbar-row">
              {["LCD Video Wall", "LED Wall"].map((item) => {
                const active = wallType === item;
                return (
                  <button
                    key={item}
                    type="button"
                    className={`wm-chip${active ? " wm-chip--active" : ""}`}
                    onClick={() => setWallType(item as WallType)}
                  >
                    {item}
                  </button>
                );
              })}
            </div>
          </div>

          <div className="wm-grid-2" style={{ gridTemplateColumns: "repeat(2, minmax(0, 1fr))" }}>
            <div className="wm-surface-card--soft" style={{ padding: 12 }}>
              <div style={{ fontSize: 12, fontWeight: 700, color: "#ffffff", marginBottom: 7 }}>Rows</div>
              <input className="wm-input-dark" type="number" value={rows} onChange={(event) => setRows(event.target.value)} />
            </div>

            <div className="wm-surface-card--soft" style={{ padding: 12 }}>
              <div style={{ fontSize: 12, fontWeight: 700, color: "#ffffff", marginBottom: 7 }}>Columns</div>
              <input className="wm-input-dark" type="number" value={cols} onChange={(event) => setCols(event.target.value)} />
            </div>
          </div>

          <div className="wm-grid-2" style={{ gridTemplateColumns: "repeat(2, minmax(0, 1fr))" }}>
            <div className="wm-surface-card--soft" style={{ padding: 12 }}>
              <div style={{ fontSize: 12, fontWeight: 700, color: "#ffffff", marginBottom: 7 }}>Source count</div>
              <input className="wm-input-dark" type="number" value={sourceCount} onChange={(event) => setSourceCount(event.target.value)} />
            </div>

            <div className="wm-surface-card--soft" style={{ padding: 12 }}>
              <div style={{ fontSize: 12, fontWeight: 700, color: "#ffffff", marginBottom: 7 }}>Bezel (mm)</div>
              <input className="wm-input-dark" type="number" value={bezelMm} onChange={(event) => setBezelMm(event.target.value)} disabled={wallType === "LED Wall"} />
            </div>
          </div>

          <div className="wm-surface-card--soft" style={{ padding: 12 }}>
            <div style={{ fontSize: 12, fontWeight: 700, color: "#ffffff", marginBottom: 7 }}>Drive strategy</div>
            <div className="wm-toolbar-row">
              {["Single canvas", "Multiview canvas", "Addressed panels"].map((item) => {
                const active = driveMode === item;
                return (
                  <button
                    key={item}
                    type="button"
                    className={`wm-chip${active ? " wm-chip--active" : ""}`}
                    onClick={() => setDriveMode(item as DriveMode)}
                  >
                    {item}
                  </button>
                );
              })}
            </div>
          </div>

          <div className="wm-surface-card--soft" style={{ padding: 12 }}>
            <div style={{ fontSize: 12, fontWeight: 700, color: "#ffffff", marginBottom: 7 }}>Project notes</div>
            <textarea
              className="wm-textarea-dark"
              placeholder="Capture wall intent, viewing expectations, content style, or customer priorities."
              value={projectNotes}
              onChange={(event) => setProjectNotes(event.target.value)}
            />
          </div>
        </aside>

        <section
          className="wm-surface-card"
          style={{
            padding: 16,
            display: "grid",
            gap: 12,
            minHeight: 0,
          }}
        >
          <div className="wm-toolbar-row" style={{ justifyContent: "space-between" }}>
            <div>
              <div className="wm-section-title">Focused detail view</div>
              <div className="wm-section-copy">
                Switch information layers instead of stacking all content vertically.
              </div>
            </div>

            <div className="wm-toolbar-row">
              <button type="button" className={`wm-chip${view === "setup" ? " wm-chip--active" : ""}`} onClick={() => setView("setup")}>
                Setup
              </button>
              <button type="button" className={`wm-chip${view === "visual" ? " wm-chip--active" : ""}`} onClick={() => setView("visual")}>
                See visual
              </button>
              <button type="button" className={`wm-chip${view === "bom" ? " wm-chip--active" : ""}`} onClick={() => setView("bom")}>
                See BOM
              </button>
              <button type="button" className={`wm-chip${view === "sales" ? " wm-chip--active" : ""}`} onClick={() => setView("sales")}>
                See sales info
              </button>
            </div>
          </div>

          <div className="wm-grid-3" style={{ gridTemplateColumns: "1.1fr 1fr 1fr" }}>
            <article className="wm-product-card">
              <div className="wm-product-card__sku">Wall format</div>
              <div className="wm-product-card__title">{derived.rows} ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â {derived.cols}</div>
              <div className="wm-product-card__copy" style={{ marginBottom: 0 }}>{derived.displays} display positions</div>
            </article>

            <article className="wm-product-card">
              <div className="wm-product-card__sku">Resolved tier</div>
              <div className="wm-product-card__title">{derived.tier}</div>
              <div className="wm-product-card__copy" style={{ marginBottom: 0 }}>{wallType}</div>
            </article>

            <article className="wm-product-card">
              <div className="wm-product-card__sku">Sources</div>
              <div className="wm-product-card__title">{derived.sources}</div>
              <div className="wm-product-card__copy" style={{ marginBottom: 0 }}>{driveMode}</div>
            </article>
          </div>

          {view === "setup" && (
            <div className="wm-fit-page__scroll" style={{ display: "grid", gap: 12 }}>
              <article className="wm-product-card">
                <div className="wm-product-card__title">Transport direction</div>
                <div className="wm-product-card__copy" style={{ marginBottom: 0 }}>{derived.transport}</div>
              </article>
            </div>
          )}

          {view === "visual" && (
            <div className="wm-fit-page__scroll" style={{ display: "grid", gap: 12 }}>
              <VisualCanvas rows={derived.rows} cols={derived.cols} wallType={wallType} />
            </div>
          )}

          {view === "bom" && (
            <div className="wm-fit-page__scroll" style={{ display: "grid", gap: 10 }}>
              {derived.products.map((item) => (
                <article key={item} className="wm-product-card">
                  <div className="wm-product-card__title">{item}</div>
                  <div className="wm-product-card__copy" style={{ marginBottom: 0 }}>
                    Suggested BOM layer for the current wall strategy.
                  </div>
                </article>
              ))}
            </div>
          )}

          {view === "sales" && (
            <div className="wm-fit-page__scroll" style={{ display: "grid", gap: 10 }}>
              {derived.sales.map((item) => (
                <article key={item} className="wm-product-card">
                  <div className="wm-product-card__copy" style={{ marginBottom: 0 }}>{item}</div>
                </article>
              ))}
            </div>
          )}

          <div className="wm-toolbar-row" style={{ justifyContent: "flex-end" }}>
            <button type="button" className="wm-btn-secondary" onClick={() => navigate(WM_ROUTES.catalog)}>
              Open catalogue
            </button>
            <button type="button" className="wm-btn-secondary" onClick={handleSaveWallToProject}>
              Open catalogue
            </button>
            <button type="button" className="wm-btn-primary" onClick={() => navigate(WM_ROUTES.proposal)}>
              Open proposal
            </button>
          </div>
        </section>
      </section>
    </div>
  );
}