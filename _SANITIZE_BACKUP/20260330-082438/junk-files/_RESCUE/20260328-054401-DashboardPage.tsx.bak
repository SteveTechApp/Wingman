import type { ReactNode } from "react";
import { useMemo } from "react";
import { useNavigate } from "react-router-dom";
import { WM_ROUTES } from "@/core/wingman/routeMap";
import GlowGuide from "@/ui2/page/GlowGuide";
import WingmanRecommendationCard from "@/features/dashboard/components/WingmanRecommendationCard";
import DecisionConfidencePanel from "@/app/navigation/DecisionConfidencePanel";

type StartPathItem = {
  id: string;
  eyebrow: string;
  title: string;
  description: string;
  ctaLabel: string;
  route: string;
  icon: ReactNode;
};

function Icon({ children }: { children: ReactNode }) {
  return (
    <span
      style={{
        width: 40,
        height: 40,
        display: "grid",
        placeItems: "center",
        borderRadius: 12,
        background: "rgba(148,163,184,0.10)",
        border: "1px solid rgba(148,163,184,0.14)",
        color: "white",
        flex: "0 0 auto",
      }}
    >
      {children}
    </span>
  );
}

function Card({ item, onClick }: { item: StartPathItem; onClick: () => void }) {
  return (
    <button
      type="button"
      onClick={onClick}
      style={{
        display: "flex",
        flexDirection: "column",
        gap: 12,
        padding: 18,
        borderRadius: 20,
        border: "1px solid rgba(148,163,184,0.14)",
        background: "linear-gradient(180deg, rgba(15,23,42,0.90), rgba(15,23,42,0.76))",
        color: "white",
        textAlign: "left",
        cursor: "pointer",
        minHeight: 220,
        boxShadow: "0 14px 28px rgba(2,8,23,0.16)",
      }}
    >
      <div style={{ display: "flex", alignItems: "center", gap: 12 }}>
        {item.icon}
        <div
          style={{
            fontSize: 12,
            fontWeight: 800,
            letterSpacing: "0.10em",
            textTransform: "uppercase",
            color: "#93c5fd",
            whiteSpace: "nowrap",
            overflow: "hidden",
            textOverflow: "ellipsis",
          }}
        >
          {item.eyebrow}
        </div>
      </div>

      <div style={{ fontSize: 26, fontWeight: 800, color: "#ffffff", lineHeight: 1.02 }}>
        {item.title}
      </div>

      <div style={{ fontSize: 13, lineHeight: 1.45, color: "rgba(226,232,240,0.84)" }}>
        {item.description}
      </div>

      <div
        style={{
          marginTop: "auto",
          fontSize: 14,
          fontWeight: 700,
          color: "#7dd3fc",
          whiteSpace: "nowrap",
        }}
      >
        {item.ctaLabel} â†’
      </div>
    </button>
  );
}

export default function DashboardPage() {
  const navigate = useNavigate();

  const items = useMemo<StartPathItem[]>(
    () => [
      {
        id: "start",
        eyebrow: "Recommended for new enquiries",
        title: "Start a project",
        description: "Capture customer requirements and begin a guided workflow for system design, product selection and proposal readiness.",
        ctaLabel: "Start project",
        route: WM_ROUTES.projectLauncher,
        icon: <Icon>â—¡</Icon>,
      },
      {
        id: "import",
        eyebrow: "Known customer brief",
        title: "Import a brief",
        description: "Start from existing requirements, notes or a customer scope, then move directly into design and recommendation workflows.",
        ctaLabel: "Import brief",
        route: `${WM_ROUTES.importIntake}?mode=document`,
        icon: <Icon>â‡©</Icon>,
      },
      {
        id: "template",
        eyebrow: "Fast starting point",
        title: "Use a template",
        description: "Open a prepared starting structure for common room types and applications, then adapt the design to the customer need.",
        ctaLabel: "Browse templates",
        route: WM_ROUTES.templates,
        icon: <Icon>â—†</Icon>,
      },
    ],
    []
  );

  return (
    <div style={{ display: "grid", gap: 14 }}>
      <section
        className="wm-surface-card"
        style={{
          display: "grid",
          gridTemplateColumns: "minmax(0, 1fr) 320px",
          gap: 16,
          padding: 18,
        }}
      >
        <div style={{ display: "grid", gap: 8 }}>
          <div style={{ fontSize: 11, fontWeight: 800, letterSpacing: "0.10em", textTransform: "uppercase", color: "#93c5fd" }}>
            Mission Control
          </div>
          <div style={{ fontSize: 30, fontWeight: 900, lineHeight: 0.96, color: "#ffffff" }}>
            Choose how you want to start
          </div>
          <div style={{ fontSize: 13, lineHeight: 1.45, color: "rgba(226,232,240,0.82)", maxWidth: 760 }}>
            Wingman should adapt to the stage of the opportunity. Start a new project, import an existing brief, or begin from a reusable template.
          </div>

          <div style={{ display: "flex", gap: 10, flexWrap: "wrap", marginTop: 4 }}>
            <button
              type="button"
              className="wm-btn-primary"
              onClick={() => navigate(WM_ROUTES.projects)}
              style={{ whiteSpace: "nowrap" }}
            >
              Open projects
            </button>
            <button
              type="button"
              className="wm-btn-secondary"
              onClick={() => navigate(WM_ROUTES.tools)}
              style={{ whiteSpace: "nowrap" }}
            >
              Browse all tools
            </button>
          </div>
        </div>

        <GlowGuide
          title="Current priority"
          activeIndex={0}
          steps={[
            { title: "Choose a start path", copy: "Decide whether this opportunity begins from scratch, from a brief, or from a reusable pattern." },
            { title: "Open the next workflow", copy: "Move into the tool that best matches the current opportunity stage." },
            { title: "Build toward output", copy: "Every path should lead into a structured proposal-ready workflow." },
          ]}
          note="Keep this page as a short decision hub. Do not overload it with deep technical detail."
        />
      </section>

      <WingmanRecommendationCard />
      <DecisionConfidencePanel />

      <section className="wm-surface-card" style={{ padding: 16 }}>
        <div style={{ fontSize: 15, fontWeight: 800, color: "#ffffff", marginBottom: 4 }}>Start paths</div>
        <div style={{ fontSize: 12, color: "rgba(226,232,240,0.74)", marginBottom: 14 }}>
          Each option uses the same design language now, but the workflow still adapts to where the opportunity is starting.
        </div>

        <div style={{ display: "grid", gridTemplateColumns: "repeat(3, minmax(0, 1fr))", gap: 14 }}>
          {items.map((item) => (
            <Card key={item.id} item={item} onClick={() => navigate(item.route)} />
          ))}
        </div>
      </section>
    </div>
  );
}