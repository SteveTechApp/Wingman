import { useEffect, useMemo, useState } from "react";
import { useNavigate } from "react-router-dom";
import { WM_ROUTES } from "@/core/wingman/routeMap";
import GlowGuide from "@/ui2/page/GlowGuide";
import { loadActiveProjectSnapshot } from "@/app/logic/wingmanProjectState";
import { buildTieredBom } from "@/app/logic/wingmanBomBuilder";

type ProposalTone = "Standard" | "Concise" | "Executive";

export default function ProposalPage() {
  const navigate = useNavigate();
  const snapshot = useMemo(() => loadActiveProjectSnapshot(), []);

  const [projectName, setProjectName] = useState("New Wingman Project");
  const [customerName, setCustomerName] = useState("");
  const [proposalTone, setProposalTone] = useState<ProposalTone>("Standard");
  const [scopeSummary, setScopeSummary] = useState("");
  const [tier, setTier] = useState<"Bronze" | "Silver" | "Gold">("Silver");

  useEffect(() => {
    if (!snapshot) return;

    if (snapshot.decision.recommendedTier) {
      setTier(snapshot.decision.recommendedTier);
    }
    if (!snapshot) return;

    setProjectName(snapshot.project.name || "New Wingman Project");
    setCustomerName(snapshot.project.customer || "");
    setScopeSummary(
      `Recommended architecture: ${snapshot.decision.architecture}. ` +
      `Primary products: ${snapshot.decision.primaryProducts.join(", ")}.`
    );
  }, [snapshot]);

  const tieredBom = useMemo(() => {
    if (!snapshot) return [];

    return buildTieredBom(snapshot.decision.architecture, tier, {
      sources: snapshot.project.discovery.sources,
      displays: snapshot.project.discovery.displays,
    });
  }, [snapshot, tier]);

  const toneCopy = useMemo(() => {
    if (proposalTone === "Executive") {
      return "Executive summary first, then key solution outcomes.";
    }
    if (proposalTone === "Concise") {
      return "Compact commercial summary with limited technical depth.";
    }
    return "Balanced technical and commercial wording for general proposals.";
  }, [proposalTone]);

  return (
    <div className="wm-fit-page wmu-adopt">
      <section className="wm-surface-card wm-fit-page__hero">
        <div>
          <div className="wm-page-kicker">Proposal Builder</div>
          <div className="wm-page-title">Customer-ready output</div>
          <div className="wm-page-copy">
            Build a clean, structured proposal driven from Discovery.
          </div>
        </div>

        <GlowGuide
          title="Next step"
          activeIndex={1}
          steps={[
            { title: "Set framing", copy: "Project and customer context" },
            { title: "Select tier", copy: "Define solution level" },
            { title: "Review outputs", copy: "Check summary and BOM" },
          ]}
        />
      </section>

      <section className="wm-fit-page__body wm-grid-2">
        <aside className="wm-surface-card" style={{ padding: 16, display: "grid", gap: 12, alignSelf: "start" }}>
          <div className="wm-section-title">Proposal setup</div>

          <div className="wm-surface-card--soft" style={{ padding: 12 }}>
            <div style={{ marginBottom: 6 }}>Project</div>
            <input
              className="wm-input-dark"
              value={projectName}
              onChange={(e) => setProjectName(e.target.value)}
            />
          </div>

          <div className="wm-surface-card--soft" style={{ padding: 12 }}>
            <div style={{ marginBottom: 6 }}>Customer</div>
            <input
              className="wm-input-dark"
              value={customerName}
              onChange={(e) => setCustomerName(e.target.value)}
            />
          </div>

          <div className="wm-surface-card--soft" style={{ padding: 12 }}>
            <div style={{ marginBottom: 6 }}>Proposal tone</div>
            <div className="wm-toolbar-row">
              {["Standard", "Concise", "Executive"].map((item) => {
                const active = proposalTone === item;
                return (
                  <button
                    key={item}
                    type="button"
                    className={`wm-chip${active ? " wm-chip--active" : ""}`}
                    onClick={() => setProposalTone(item as ProposalTone)}
                  >
                    {item}
                  </button>
                );
              })}
            </div>
          </div>

          <div className="wm-surface-card--soft" style={{ padding: 12 }}>
            <div style={{ marginBottom: 6 }}>Solution tier</div>
            <div className="wm-toolbar-row">
              {["Bronze", "Silver", "Gold"].map((item) => {
                const active = tier === item;
                return (
                  <button
                    key={item}
                    type="button"
                    className={`wm-chip${active ? " wm-chip--active" : ""}`}
                    onClick={() => setTier(item as "Bronze" | "Silver" | "Gold")}
                  >
                    {item}
                  </button>
                );
              })}
            </div>
          </div>
        </aside>

        <section className="wm-surface-card" style={{ padding: 16, display: "grid", gap: 12 }}>
          <div className="wm-section-title">Proposal output</div>

          <article className="wm-product-card">
            <div className="wm-product-card__sku">Executive summary</div>
            <div className="wm-product-card__copy">{scopeSummary || "No summary available."}</div>
          </article>

          <article className="wm-product-card">
            <div className="wm-product-card__sku">Tone</div>
            <div className="wm-product-card__copy">{toneCopy}</div>
          </article>

          <article className="wm-product-card">
            <div className="wm-product-card__sku">Bill of materials ({tier})</div>

            {tieredBom.length > 0 ? (
              <div style={{ display: "grid", gap: 10 }}>
                {tieredBom.map((item, i) => (
                  <div
                    key={`${item.sku}-${i}`}
                    style={{
                      display: "grid",
                      gridTemplateColumns: "180px 80px 140px minmax(0, 1fr)",
                      gap: 10,
                      padding: "10px 12px",
                      borderRadius: 12,
                      background: "rgba(255,255,255,0.04)",
                      border: "1px solid rgba(255,255,255,0.06)",
                      alignItems: "start",
                    }}
                  >
                    <div style={{ fontWeight: 700, color: "#ffffff" }}>{item.sku}</div>
                    <div style={{ color: "rgba(226,232,240,0.86)" }}>Qty {item.qty}</div>
                    <div style={{ color: "rgba(226,232,240,0.72)" }}>{item.role}</div>
                    <div style={{ color: "rgba(226,232,240,0.72)" }}>{item.description}</div>
                  </div>
                ))}
              </div>
            ) : (
              <div className="wm-product-card__copy">No BOM available yet.</div>
            )}
          </article>

          <div className="wm-toolbar-row">
            <button
              type="button"
              className="wm-btn-secondary"
              onClick={() => navigate(WM_ROUTES.catalog)}
            >
              Catalogue
            </button>

            <button
              type="button"
              className="wm-btn-primary"
              onClick={() => navigate(WM_ROUTES.projects)}
            >
              Save
            </button>
          </div>
        </section>
      </section>
    </div>
  );
}