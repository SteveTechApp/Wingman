import * as React from "react";
import { Link, useNavigate, useParams, useSearchParams } from "react-router-dom";

import {
  addProjectComment,
  createProjectShare,
  getActiveProject,
  getProjectById,
  setActiveProjectId,
  subscribeProjects,
} from "@/features/projects/projectStore";
import { buildCustomerSafeSummary } from "@/features/projects/customerSummary";
import { useAuth } from "@/context";
import WingmanPersistedSummaryPanel from "@/features/projects/WingmanPersistedSummaryPanel";

type OverviewTab = "summary" | "technical" | "customer" | "collaboration" | "deployment";

type SummaryRow = {
  label: string;
  value: string;
};

const OVERVIEW_TABS: Array<{ id: OverviewTab; label: string }> = [
  { id: "summary", label: "Summary" },
  { id: "technical", label: "Technical" },
  { id: "customer", label: "Customer" },
  { id: "collaboration", label: "Collaboration" },
  { id: "deployment", label: "Deployment" },
];

function formatDate(iso: string | undefined): string {
  if (!iso) return "-";
  const parsed = new Date(iso);
  if (Number.isNaN(parsed.getTime())) return iso;
  return parsed.toLocaleString();
}

function asDisplay(value: unknown): string {
  if (value === null || value === undefined) return "-";
  const text = String(value).trim();
  return text ? text : "-";
}

function renderSummaryRows(rows: SummaryRow[]) {
  return (
    <div className="wm-summary-list">
      {rows.map((row) => (
        <div key={row.label} className="wm-summary-row">
          <span>{row.label}</span>
          <strong>{row.value || "-"}</strong>
        </div>
      ))}
    </div>
  );
}

export default function ProjectOverviewPage() {
  const nav = useNavigate();
  const { id } = useParams<{ id?: string }>();
  const [searchParams] = useSearchParams();
  const { permissions, workspaceRole } = useAuth();

  const project = React.useSyncExternalStore(
    subscribeProjects,
    () => {
      const paramId = id || searchParams.get("projectId") || undefined;
      if (paramId) return getProjectById(paramId) ?? null;
      return getActiveProject() ?? null;
    },
    () => getActiveProject() ?? null,
  );

  React.useEffect(() => {
    if (project?.id) {
      setActiveProjectId(project.id);
    }
  }, [project?.id]);

  const [activeTab, setActiveTab] = React.useState<OverviewTab>("summary");
  const [commentBody, setCommentBody] = React.useState("");
  const [commentAudience, setCommentAudience] = React.useState<"internal" | "customer">("internal");
  const [shareMessage, setShareMessage] = React.useState("");
  const [savingComment, setSavingComment] = React.useState(false);
  const [sharing, setSharing] = React.useState(false);
  const [actionError, setActionError] = React.useState<string | null>(null);

  const customerSummary = React.useMemo(
    () => (project ? project.customerSummary ?? buildCustomerSafeSummary(project) : null),
    [project],
  );

  React.useEffect(() => {
    if (!permissions.canCreateInternalComments && commentAudience === "internal") {
      setCommentAudience("customer");
    }
  }, [commentAudience, permissions.canCreateInternalComments]);

  if (!project) {
    return (
      <div className="wm-page wm-project-overview-page">
        <section className="wm-hero">
          <div className="wm-grid">
            <div className="wm-title-xl">Project not found</div>
            <div className="wm-body">
              The requested project could not be loaded. Return to Projects and pick an active record.
            </div>
            <div className="wm-actions-row">
              <button
                type="button"
                className="wm-btn wm-btn-primary"
                onClick={() => nav("/app/projects")}
              >
                Back to Projects
              </button>
            </div>
          </div>
        </section>
      </div>
    );
  }

  const nextRecommendedAction = project.discovery?.recommendedNextTool
    ? `Continue in ${project.discovery.recommendedNextTool}`
    : project.proposal?.title
      ? "Review proposal output"
      : "Continue Guided Project";

  const summaryRows: SummaryRow[] = [
    { label: "Customer", value: asDisplay(project.customer) },
    { label: "Site", value: asDisplay(project.site) },
    { label: "Room", value: asDisplay(project.roomName) },
    { label: "Stage", value: asDisplay(project.stage || "Discovery") },
    { label: "Status", value: asDisplay(project.status || "Draft") },
    { label: "Updated", value: formatDate(project.updatedAt) },
  ];

  const technicalRowsLeft: SummaryRow[] = [
    { label: "Application", value: asDisplay(project.discovery?.applicationType) },
    { label: "Display count", value: asDisplay(project.discovery?.displayCount) },
    { label: "Source count", value: asDisplay(project.discovery?.sourceCount) },
    { label: "Distance", value: asDisplay(project.discovery?.cableDistanceM) },
    { label: "Reach band", value: asDisplay(project.discovery?.transportDistanceBand) },
    { label: "Signal formats", value: asDisplay(project.discovery?.signalFormats) },
    { label: "HDR", value: asDisplay(project.discovery?.signalHdr) },
    { label: "USB workflow", value: asDisplay(project.discovery?.usbNeeds) },
    { label: "USB bandwidth", value: asDisplay(project.discovery?.usbStandards) },
  ];

  const technicalRowsRight: SummaryRow[] = [
    { label: "Source placement", value: asDisplay(project.discovery?.sourcePlacement) },
    { label: "Source ingress", value: asDisplay(project.discovery?.sourceConnectionPath) },
    { label: "Source transport", value: asDisplay(project.discovery?.sourceConnectionType) },
    { label: "Source cable", value: asDisplay(project.discovery?.sourceCableType) },
    { label: "Display delivery", value: asDisplay(project.discovery?.displayConnectionPath) },
    { label: "Display transport", value: asDisplay(project.discovery?.displayConnectionType) },
    { label: "Display cable", value: asDisplay(project.discovery?.displayCableType) },
    { label: "Floor type", value: asDisplay(project.discovery?.floorType) },
    { label: "Ceiling", value: asDisplay(project.discovery?.ceilingType) },
    { label: "Network", value: asDisplay(project.discovery?.networkEnvironment) },
  ];

  const commercialRows: SummaryRow[] = [
    { label: "Template", value: asDisplay(project.template?.application) },
    { label: "Competitor SKU", value: asDisplay(project.compare?.competitorSku) },
    { label: "Proposal title", value: asDisplay(project.proposal?.title) },
    { label: "Rule version", value: asDisplay(project.recommendationGovernance?.ruleSetVersion) },
    { label: "Catalog version", value: asDisplay(project.recommendationGovernance?.catalogVersion) },
    { label: "Primary fit", value: asDisplay(project.recommendationGovernance?.primaryRecommendation) },
  ];

  async function submitComment() {
    if (!project) return;
    if (!commentBody.trim()) return;

    setSavingComment(true);
    setActionError(null);

    try {
      await addProjectComment(project.id, {
        body: commentBody,
        audience: commentAudience,
      });
      setCommentBody("");
    } catch (error) {
      setActionError(error instanceof Error ? error.message : "Unable to save this comment.");
    } finally {
      setSavingComment(false);
    }
  }

  async function prepareShare() {
    if (!project) return;
    if (!customerSummary) return;

    setSharing(true);
    setActionError(null);

    try {
      await createProjectShare(project.id, {
        title: `${customerSummary.headline} share pack`,
        message: shareMessage || customerSummary.overview,
        audience: "customer",
        summaryHeadline: customerSummary.headline,
      });
      setShareMessage("");
    } catch (error) {
      setActionError(error instanceof Error ? error.message : "Unable to prepare this share pack.");
    } finally {
      setSharing(false);
    }
  }

  return (
    <div className="wm-page wm-project-overview-page">
      <section className="wm-hero">
        <div className="wm-page-hero-row wm-project-overview-page__hero">
          <div className="wm-grid wm-project-overview-page__hero-copy">
            <div className="wm-kicker">
              {project.stage || "Discovery"} | {project.status || "Draft"}
            </div>
            <div className="wm-title-xl">{project.name}</div>
            <div className="wm-body-sm">
              {project.customer || "Customer not set"} | {project.site || "Site not set"}
            </div>
            <div className="wm-project-overview-page__hero-next">
              Next recommended move: {nextRecommendedAction}
            </div>
          </div>

          <div className="wm-actions-row">
            <Link className="wm-btn" to="/app/projects">Projects</Link>
            <Link className="wm-btn" to="/app/tools/discovery">Guided Project</Link>
            <Link className="wm-btn" to="/app/tools/catalog">Products</Link>
            <Link className="wm-btn wm-btn-primary" to="/app/tools/proposal">Proposal</Link>
          </div>
        </div>
      </section>

      <section className="wm-section wm-project-overview-page__tabs-shell">
        <div className="wm-project-overview-page__tabs" role="tablist" aria-label="Project overview sections">
          {OVERVIEW_TABS.map((tab) => (
            <button
              key={tab.id}
              type="button"
              role="tab"
              aria-selected={activeTab === tab.id}
              className={`wm-project-overview-page__tab${activeTab === tab.id ? " is-active" : ""}`}
              onClick={() => setActiveTab(tab.id)}
            >
              {tab.label}
            </button>
          ))}
        </div>
      </section>

      {activeTab === "summary" ? (
        <div className="wm-project-overview-page__tab-body">
          <WingmanPersistedSummaryPanel />

          <section className="wm-section wm-section--tone-cyan">
            <div className="wm-section__head">
              <div className="wm-section__titles">
                <h2>Project summary</h2>
                <p>The first-read view of the opportunity, current fit, and what needs attention next.</p>
              </div>
            </div>

            <div className="wm-grid-cards wm-project-overview-page__kpis">
              <article className="wm-work-card">
                <div className="wm-section-title">Stage</div>
                <div className="wm-title-lg">{project.stage || "Discovery"}</div>
              </article>
              <article className="wm-work-card">
                <div className="wm-section-title">Status</div>
                <div className="wm-title-lg">{project.status || "Draft"}</div>
              </article>
              <article className="wm-work-card">
                <div className="wm-section-title">Primary fit</div>
                <div className="wm-title-lg">{project.recommendationGovernance?.primaryRecommendation || "-"}</div>
              </article>
              <article className="wm-work-card">
                <div className="wm-section-title">Updated</div>
                <div className="wm-title-lg wm-project-overview-page__date">{formatDate(project.updatedAt)}</div>
              </article>
            </div>
          </section>

          <div className="wm-split-columns">
            <section className="wm-section wm-section--compact wm-section--tone-indigo">
              <div className="wm-section__head">
                <div className="wm-section__titles">
                  <h2>Core details</h2>
                  <p>The commercial basics and current record state.</p>
                </div>
              </div>
              {renderSummaryRows(summaryRows)}
            </section>

            <section className="wm-section wm-section--compact wm-section--tone-cyan">
              <div className="wm-section__head">
                <div className="wm-section__titles">
                  <h2>Current recommendation</h2>
                  <p>The current Wingman reading before moving deeper into technical detail.</p>
                </div>
              </div>

              <div className="wm-project-overview-page__focus-stack">
                <div className="wm-project-overview-page__focus-pill">
                  {project.recommendationGovernance?.primaryRecommendation || "No governed recommendation yet"}
                </div>
                <div className="wm-body-sm">
                  {project.discovery?.recommendedFamilies
                    ? `Recommended families: ${project.discovery.recommendedFamilies}`
                    : "Save Guided Project to capture the latest recommendation families."}
                </div>
                <ul className="wm-gp__list">
                  {(customerSummary?.openRisks ?? []).length > 0 ? (
                    customerSummary?.openRisks.map((item) => <li key={item}>{item}</li>)
                  ) : (
                    <li>No major open risks are currently exposed in the customer-safe summary.</li>
                  )}
                </ul>
              </div>
            </section>
          </div>

          <section className="wm-section wm-section--compact wm-section--tone-amber">
            <div className="wm-section__head">
              <div className="wm-section__titles">
                <h2>Context notes</h2>
                <p>Qualification and install notes captured against the project.</p>
              </div>
            </div>
            <div className="wm-body wm-project-overview-page__notes">
              {project.notes?.trim() || "No notes captured yet."}
            </div>
          </section>
        </div>
      ) : null}

      {activeTab === "technical" ? (
        <div className="wm-project-overview-page__tab-body">
          <div className="wm-split-columns">
            <section className="wm-section wm-section--compact wm-section--tone-cyan">
              <div className="wm-section__head">
                <div className="wm-section__titles">
                  <h2>Signal envelope</h2>
                  <p>Room, display, signal, and USB details from Guided Project.</p>
                </div>
              </div>
              {renderSummaryRows(technicalRowsLeft)}
            </section>

            <section className="wm-section wm-section--compact wm-section--tone-indigo">
              <div className="wm-section__head">
                <div className="wm-section__titles">
                  <h2>Physical path</h2>
                  <p>How sources, transport, and display delivery are currently understood.</p>
                </div>
              </div>
              {renderSummaryRows(technicalRowsRight)}
            </section>
          </div>

          <div className="wm-split-columns">
            <section className="wm-section wm-section--compact wm-section--tone-amber">
              <div className="wm-section__head">
                <div className="wm-section__titles">
                  <h2>Commercial mapping</h2>
                  <p>Downstream linking from architecture, comparison, and proposal tooling.</p>
                </div>
              </div>
              {renderSummaryRows(commercialRows)}
            </section>

            <section className="wm-section wm-section--compact wm-section--tone-emerald">
              <div className="wm-section__head">
                <div className="wm-section__titles">
                  <h2>Video wall</h2>
                  <p>Current video wall state if this opportunity includes one.</p>
                </div>
              </div>
              {project.videowall ? (
                renderSummaryRows([
                  { label: "Technology", value: asDisplay(project.videowall.technology) },
                  { label: "Rows", value: asDisplay(project.videowall.rows) },
                  { label: "Cols", value: asDisplay(project.videowall.cols) },
                  { label: "Recommended SKU", value: asDisplay(project.videowall.recommendedSku) },
                  { label: "Processor", value: asDisplay(project.videowall.processorRecommendation) },
                ])
              ) : (
                <div className="wm-body">No video wall detail saved on this project yet.</div>
              )}
            </section>
          </div>
        </div>
      ) : null}

      {activeTab === "customer" ? (
        <div className="wm-project-overview-page__tab-body">
          <section className="wm-section wm-section--tone-cyan">
            <div className="wm-section__head">
              <div className="wm-section__titles">
                <h2>Customer-safe summary</h2>
                <p>Use this to frame the opportunity for external sharing and proposal narrative.</p>
              </div>
            </div>

            {customerSummary ? (
              <div className="wm-grid" style={{ gap: 16 }}>
                <div className="wm-title-lg">{customerSummary.headline}</div>
                <div className="wm-body">{customerSummary.overview}</div>

                <div className="wm-split-columns">
                  <div>
                    <div className="wm-section-title">Overview</div>
                    <div className="wm-body">
                      {customerSummary.overview || "No overview captured yet."}
                    </div>
                  </div>

                  <div>
                    <div className="wm-section-title">Open risks</div>
                    <ul className="wm-gp__list">
                      {(customerSummary.openRisks ?? []).length > 0 ? (
                        customerSummary.openRisks.map((item) => <li key={item}>{item}</li>)
                      ) : (
                        <li>No customer-facing risks recorded yet.</li>
                      )}
                    </ul>
                  </div>
                </div>
              </div>
            ) : (
              <div className="wm-body">No customer-safe summary available yet.</div>
            )}
          </section>
        </div>
      ) : null}

      {activeTab === "collaboration" ? (
        <div className="wm-project-overview-page__tab-body">
          <div className="wm-split-columns">
            <section className="wm-section wm-section--compact wm-section--tone-indigo">
              <div className="wm-section__head">
                <div className="wm-section__titles">
                  <h2>Comments</h2>
                  <p>Capture internal or customer-facing notes against the project.</p>
                </div>
              </div>

              <div className="wm-grid" style={{ gap: 12 }}>
                <div className="wm-body-sm">Workspace role: {workspaceRole || "Unknown"}</div>

                <select
                  className="wm-input"
                  value={commentAudience}
                  onChange={(event) => setCommentAudience(event.target.value as "internal" | "customer")}
                >
                  {permissions.canCreateInternalComments ? <option value="internal">Internal</option> : null}
                  <option value="customer">Customer</option>
                </select>

                <textarea
                  className="wm-input"
                  rows={5}
                  value={commentBody}
                  onChange={(event) => setCommentBody(event.target.value)}
                  placeholder="Add a project comment"
                />

                <div className="wm-actions-row">
                  <button
                    type="button"
                    className="wm-btn wm-btn-primary"
                    disabled={savingComment || !commentBody.trim()}
                    onClick={submitComment}
                  >
                    {savingComment ? "Saving..." : "Save comment"}
                  </button>
                </div>

                {actionError ? <div className="wm-body-sm">{actionError}</div> : null}
              </div>
            </section>

            <section className="wm-section wm-section--compact wm-section--tone-cyan">
              <div className="wm-section__head">
                <div className="wm-section__titles">
                  <h2>Share pack</h2>
                  <p>Create a customer-safe share payload from the current project state.</p>
                </div>
              </div>

              <div className="wm-grid" style={{ gap: 12 }}>
                <textarea
                  className="wm-input"
                  rows={6}
                  value={shareMessage}
                  onChange={(event) => setShareMessage(event.target.value)}
                  placeholder="Optional share message"
                />

                <div className="wm-actions-row">
                  <button
                    type="button"
                    className="wm-btn wm-btn-primary"
                    disabled={sharing || !customerSummary}
                    onClick={prepareShare}
                  >
                    {sharing ? "Preparing..." : "Prepare share"}
                  </button>
                </div>
              </div>
            </section>
          </div>
        </div>
      ) : null}

      {activeTab === "deployment" ? (
        <div className="wm-project-overview-page__tab-body">
          <div className="wm-split-columns">
            <section className="wm-section wm-section--compact wm-section--tone-amber">
              <div className="wm-section__head">
                <div className="wm-section__titles">
                  <h2>Attachments</h2>
                  <p>Documents and diagrams linked to this project.</p>
                </div>
              </div>

              {(project.attachments ?? []).length > 0 ? (
                <div className="wm-grid" style={{ gap: 10 }}>
                  {project.attachments?.map((attachment) => (
                    <article key={attachment.id} className="wm-work-card">
                      <div className="wm-section-title">{attachment.kind}</div>
                      <div className="wm-title-lg">{attachment.name}</div>
                      <div className="wm-body-sm">{attachment.summary || attachment.source}</div>
                    </article>
                  ))}
                </div>
              ) : (
                <div className="wm-body">No attachments saved yet.</div>
              )}
            </section>

            <section className="wm-section wm-section--compact wm-section--tone-emerald">
              <div className="wm-section__head">
                <div className="wm-section__titles">
                  <h2>Deployment readiness</h2>
                  <p>Basic readiness view before final commercial and technical issue.</p>
                </div>
              </div>

              {renderSummaryRows([
                { label: "Proposal title", value: asDisplay(project.proposal?.title) },
                { label: "Notes", value: project.notes?.trim() ? "Present" : "None" },
                { label: "Comments", value: asDisplay((project.comments ?? []).length) },
                { label: "Shares", value: asDisplay((project.shares ?? []).length) },
                { label: "Attachments", value: asDisplay((project.attachments ?? []).length) },
              ])}
            </section>
          </div>
        </div>
      ) : null}
    </div>
  );
}