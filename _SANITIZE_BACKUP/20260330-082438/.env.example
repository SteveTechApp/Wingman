SUPABASE_LOOKUP_DIAGNOSTICS_TABLE=competitor_lookup_runtime_events

LOOKUP_ENABLE_LIVE_ENRICHMENT=true
LOOKUP_RETRY_ATTEMPTS=3
LOOKUP_TIMEOUT_MS=4500
LOOKUP_CACHE_TTL_MS=1800000
LOOKUP_CACHE_MAX_ENTRIES=500
LOOKUP_RATE_LIMIT_WINDOW_MS=60000
LOOKUP_RATE_LIMIT_MAX_REQUESTS=12
LOOKUP_RUNTIME_EVENT_MAX=120
LOOKUP_RUNTIME_EVENT_RETENTION_DAYS=30
LOOKUP_PERSIST_RUNTIME_EVENTS=true
WINGMAN_SESSION_TTL_MS=604800000
WINGMAN_AUDIT_RETENTION=800
WINGMAN_TELEMETRY_RETENTION=400
WINGMAN_STORAGE_MODE=auto
SUPABASE_WINGMAN_TABLES_ENABLED=false
SUPABASE_WINGMAN_STATE_TABLE=wingman_app_state
SUPABASE_WINGMAN_STATE_ROW_ID=global
SUPABASE_WINGMAN_USERS_TABLE=wingman_users
SUPABASE_WINGMAN_WORKSPACES_TABLE=wingman_workspaces
