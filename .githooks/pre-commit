#!/bin/sh
echo "Wingman pre-commit..."

# Fast lane: hand edits to package.json/package-lock.json are the cheapest way
# to silently drop an override floor, so check them BEFORE the full verify
# chain spends minutes on typecheck/build/tests. Gate the guard on whether the
# commit actually touches those files (staged diff, empty tree = HEAD) so
# unrelated commits pay ~80ms, not the full gate.
if git diff --cached --quiet -- package.json package-lock.json; then
  echo "pre-commit: no staged package.json/package-lock.json changes - skipping override-floor fast lane"
else
  echo "pre-commit: staged package manifest changes - running check:override-floors"
  npm run --silent check:override-floors
  fast_status=$?
  if [ $fast_status -ne 0 ]; then
    echo "Commit blocked (override floors broken by staged package manifest changes)"
    exit 1
  fi
fi

# Tracked-asset duplicates: the guard reads the git index, and the commit is the
# moment a file becomes part of the repository, so this is the only surface where
# a second copy of a photograph or a document can be refused before it exists.
# Asked here rather than left to the suite below because the whole question costs
# about 400ms of hashing: a duplicate names itself in one line now instead of
# arriving as one failure among thousands of tests minutes later. The address is
# the spec itself, so there is one implementation of "the same bytes" and a
# failure here is the sentence that spec writes.
#
# The existence test is not decoration: `tools/dead-css-failure-integration.test.mjs`
# copies this hook into a throwaway repository with no spec in it, and there the
# runner exits non-zero for finding no test file — which would block that fixture
# before the gate the fixture exists to prove could answer.
if [ -f src/__tests__/trackedAssetDuplicates.test.ts ]; then
  echo "pre-commit: tracked-asset duplicate guard"
  npx --no-install vitest run src/__tests__/trackedAssetDuplicates.test.ts
  asset_duplicate_status=$?
  if [ $asset_duplicate_status -ne 0 ]; then
    echo "Commit blocked (two tracked assets hold the same bytes - see the failure above)"
    exit 1
  fi
fi

# Dead CSS: split selector branches no markup can match and drop the baseline
# allowances the split just invalidated, BEFORE the dead-css gate inspects the
# tree. Only the files this step rewrote are staged, so an unrelated edit
# elsewhere in the working tree stays unstaged.
echo "pre-commit: dead CSS autofix"
dead_css_changed="$(node tools/autofix-dead-css.mjs --print-changed)"
dead_css_status=$?
if [ $dead_css_status -ne 0 ]; then
  echo "Commit blocked (dead CSS autofix failed)"
  exit 1
fi
if [ -n "$dead_css_changed" ]; then
  echo "pre-commit: staging dead CSS autofix output"
  printf '%s\n' "$dead_css_changed" | while IFS= read -r file; do
    [ -z "$file" ] && continue
    echo "pre-commit:   $file"
    git add -- "$file" || exit 1
  done
  dead_css_stage_status=$?
  if [ $dead_css_stage_status -ne 0 ]; then
    echo "Commit blocked (staging the dead CSS autofix output failed)"
    exit 1
  fi
fi

npm run --silent check:dead-css
dead_css_gate_status=$?
if [ $dead_css_gate_status -ne 0 ]; then
  node tools/autofix-dead-css.mjs --propose-deletions
  echo "Commit blocked (dead CSS gate failed)"
  exit 1
fi

npm run precommit:check
status=$?

if [ $status -ne 0 ]; then
  echo "Commit blocked (typecheck/build failed)"
  exit 1
fi

exit 0
