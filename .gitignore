node_modules/
dist/
build/
.vite/
.cache/
coverage/
.npm/
.pnpm-store/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- TypeScript / tooling ---
*.tsbuildinfo

# --- OS junk ---
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# --- IDE / editor ---
.vscode/
.idea/
*.suo
*.user
*.userossc
*.sln.docstates

