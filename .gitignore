*.tmp
*.temp
*.bak
*.old
*.orig
*.rej
*~
New Text Document.txt

# --- PowerShell / script scratch ---
*.ps1.bak

# --- Runtime / generated data ---
data/*.json
!data/.gitkeep
!data/README.md
!data/seed/
!data/seed/**
!data/wyrestorm-product-intelligence.json

# --- Databases / local server state ---
*.db
*.sqlite
*.sqlite3

# --- Upload / export / generated assets ---
uploads/
exports/
tmp/
temp/

# --- Internal work / quarantine / rescue ---
_WORK/
_RESCUE/
_QUARANTINE/
_AUDITS/
_release/
release/

# --- Nested duplicate project protection ---
wingman/node_modules/
wingman/dist/
wingman/.vite/
wingman/build/
wingman/package-lock.json

