.wingman-work/
.freebuff/
.codex/

# --- Runtime / generated data ---
# Only the generated/runtime files below are ignored, explicitly. Do not add a
# broad data/*.json rule: it silently hides every new top-level data JSON from
# git status, which is what forced force-adds for tracked governance files
# (e.g. data/wyrestorm-product-role-overrides.json). A new data JSON is tracked
# by default unless it is generated at build/run time - if so, add it here with
# a one-line comment naming its generator/consumer.
# Generated by tools/build-wingman-canonical-data.mjs / tools/build-product-data-sources.mjs
data/wingman-canonical-product-store.json
data/wingman-data-maintenance-queue.json
# Written by tools/check-wyrestorm-product-updates.mjs
data/wyrestorm-product-update-candidates.json
# Runtime stores (server writes at runtime, or large audit fixtures with no consumer)
data/competitor-approvals.json
data/competitor-live-lookup-records.json
data/compare-golden-set.json
data/product-intelligence-drafts.json
data/wingman-source-pdf-intelligence.json
# Legacy generated databases kept out of the tree (tracked negations below are
# the files that DO belong in git)
!data/wyrestorm-product-intelligence.json
!data/product-intelligence-db.json
# Runtime workspace (server data-dir mode)
data/runtime/

# --- Databases / local server state ---
*.db
*.sqlite
*.sqlite3

# --- Upload / export / generated assets ---
uploads/
exports/
tmp/
temp/

# --- Internal work / quarantine / rescue ---
_WORK/
_RESCUE/
_RECOVERY/
_IMPORT/
_QUARANTINE/
quarantine/
_AUDITS/
_backup*/
_backups/
backups/
.DISCARDED/
_review/
lighthouse-reports/
reports/
_release/
release/
_wingman_backup_*/

# --- Nested duplicate project protection ---
wingman/node_modules/
wingman/dist/
wingman/.vite/
wingman/build/
wingman/package-lock.json

# --- Archives ---
# Historical material belongs outside the active repository. Git history and
# archive/* branches retain material removed from the working tree.
archive/
*.zip
*.tar
*.gz
*.7z
*.rar

# --- Source maps generated by tooling ---
*.css.map
*.js.map

# --- Vite oddities ---
vite.config.ts.timestamp-*
test-results

# --- Commercial pricing (sensitive, server-side only) ---
data/governance/wyrestorm-pricing.json

# --- OSV build-dependency survey cache (generated by tools/check-build-deps.mjs) ---
tools/build-dep-cache.generated.json
