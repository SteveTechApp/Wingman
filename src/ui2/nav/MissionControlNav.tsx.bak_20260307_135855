import * as React from "react";
import { NavLink } from "react-router-dom";

type NavItem = {
  label: string;
  to: string;
  icon: string;
  title?: string;
};

type NavSection = {
  heading: string;
  items: NavItem[];
};

const sections: NavSection[] = [
  {
    heading: "Workspace",
    items: [
      { label: "Dashboard", to: "/app/dashboard", icon: "◫", title: "Dashboard overview" },
      { label: "Projects", to: "/app/projects", icon: "▣", title: "Live project workspace" },
    ],
  },
  {
    heading: "Core Tools",
    items: [
      { label: "Discovery", to: "/app/tools/discovery", icon: "◎", title: "Discovery Wizard" },
      { label: "Room Wizard", to: "/app/tools/room-wizard", icon: "⌂", title: "Room Wizard" },
      { label: "Product Catalog", to: "/app/tools/catalog", icon: "◪", title: "Product Catalog" },
      { label: "Proposal Builder", to: "/app/tools/proposal-builder", icon: "✎", title: "Proposal Builder" },
      { label: "Templates", to: "/app/tools/templates", icon: "📋", title: "Templates" },
      { label: "Video Wall Builder", to: "/app/tools/video-wall-builder", icon: "🧱", title: "Video Wall Builder" },
      { label: "Cable Schedule", to: "/app/tools/cable-schedule", icon: "🔌", title: "Cable Schedule" },
      { label: "Block Diagram", to: "/app/tools/block-diagram", icon: "📊", title: "Block Diagram" },
      { label: "Design Review", to: "/app/tools/design-review", icon: "✔", title: "Design Review" },
      { label: "Guru", to: "/app/tools/guru", icon: "✦", title: "Guru AV assistant" },
    ],
  },
  {
    heading: "More",
    items: [
      { label: "Tool Hub", to: "/app/tools", icon: "◩", title: "Tool Hub" },
      { label: "Import Intake", to: "/app/tools/import-intake", icon: "⇪", title: "Import Intake" },
    ],
  },
];

function navClass(isActive: boolean): string {
  return isActive ? "wm-mc__link is-active" : "wm-mc__link";
}

export default function MissionControlNav() {
  return (
    <nav className="wm-mc" aria-label="Mission Control">
      {sections.map((section) => (
        <section key={section.heading} className="wm-mc__section">
          <div className="wm-mc__heading">{section.heading}</div>

          <ul className="wm-mc__list">
            {section.items.map((item) => (
              <li key={item.to} className="wm-mc__item">
                <NavLink
                  to={item.to}
                  className={({ isActive }) => navClass(isActive)}
                  title={item.title ?? item.label}
                  aria-label={item.title ?? item.label}
                  data-wm-tooltip={item.title ?? item.label}
                >
                  <span className="wm-mc__icon" aria-hidden="true">
                    {item.icon}
                  </span>
                  <span>{item.label}</span>
                </NavLink>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </nav>
  );
}