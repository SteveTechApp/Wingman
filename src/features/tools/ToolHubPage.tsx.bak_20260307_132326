function ToolTile({ t }: { t: Tool }) {
  const I = t.Icon;

  return (
    <Link className="wm-tile" to={t.to}>
      <div className="wm-tile__top">
        <div className="wm-tile__icon">
          <I size={20} />
        </div>
        <span className="wm-tile__tag">{t.tag}</span>
      </div>

      <div className="wm-tile__title">{t.title}</div>
      <div className="wm-tile__desc">{t.desc}</div>

      <div className="wm-tile__meta">
        <span className="wm-tile__cta">
          Open <ArrowRight size={16} />
        </span>
        <span style={{ opacity: 0.55, fontSize: 12 }}>Ready</span>
      </div>
    </Link>
  );
}

function chipStyle(): React.CSSProperties {
  return {
    display: "inline-flex",
    alignItems: "center",
    minHeight: 28,
    padding: "6px 10px",
    borderRadius: 999,
    border: "1px solid rgba(255,255,255,0.10)",
    background: "rgba(255,255,255,0.06)",
    fontSize: 12,
    lineHeight: 1,
    whiteSpace: "nowrap",
  };
}

function buttonStyle(primary?: boolean): React.CSSProperties {
  return {
    borderRadius: 12,
    border: primary
      ? "1px solid rgba(120,200,255,0.26)"
      : "1px solid rgba(255,255,255,0.12)",
    background: primary
      ? "rgba(120,200,255,0.14)"
      : "rgba(255,255,255,0.08)",
    color: "rgba(255,255,255,0.92)",
    padding: "9px 12px",
    minHeight: 36,
    cursor: "pointer",
    font: "inherit",
    whiteSpace: "nowrap",
  };
}

function fmtDate(iso?: string): string {
  if (!iso) return "ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â";
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return "ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â";
  return d.toLocaleString();
}

export default function ToolHubPage() {
  const nav = useNavigate();
    const [tick, setTick] = React.useState<string>(() => getProjectsTick());
  React.useEffect(() => {
    const onStorage = (e: StorageEvent) => {
      if (e.key === "wm_projects_tick") setTick(getProjectsTick());
    };
    window.addEventListener("storage", onStorage);
    const t = window.setInterval(() => setTick(getProjectsTick()), 800);
    return () => {
      window.removeEventListener("storage", onStorage);
      window.clearInterval(t);
    };
  }, []);

  const activeProject = React.useMemo(() => getActiveProject(), [tick]);

  const selectedSkuCount = Array.isArray(activeProject?.catalog?.skus)
    ? activeProject!.catalog!.skus.length
    : 0;

  const hasDiscovery = !!activeProject?.discovery;
  const hasCatalog = selectedSkuCount > 0;
  const hasProposal = !!activeProject?.proposal;

  const nextAction = !activeProject
    ? { label: "Start New Project", to: "/app/projects/new" }
    : !hasDiscovery
    ? { label: "Complete Discovery", to: "/app/tools/discovery" }
    : !hasCatalog
    ? { label: "Select Catalog SKUs", to: "/app/tools/catalog" }
    : !hasProposal
    ? { label: "Build Proposal", to: "/app/tools/proposal" }
    : { label: "Review Projects", to: "/app/projects" };

  return (
    <div className="wm-shell-body" style={{ display: "flex" }}>
      <div className="wm-sidenav-wrap">
        <aside className="wm-sidenav">
          {/* __WM_MISSION_CONTROL_SHELL_PATCH_V1__ */}
        </aside>
      </div>

      <main className="wm-main">
        <div className="wm-toolhub-head wm-page-toolhub">
          <div>
            <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
              <LayoutGrid size={18} />
              <div
                style={{
                  fontWeight: 900,
                  fontSize: 18,
                  color: "rgba(255,255,255,0.92)",
                }}
              >
                Tool Hub
              </div>
            </div>
            <div className="wm-toolhub-kicker">
              Launch tools. Left panel now shows workspace context.
            </div>
          </div>
        </div>

        <div
          style={{
            border: "1px solid rgba(255,255,255,0.10)",
            borderRadius: 16,
            background: "rgba(16,22,32,0.72)",
            padding: 14,
            marginBottom: 14,
          }}
        >
          <div
            style={{
              display: "flex",
              justifyContent: "space-between",
              gap: 12,
              alignItems: "center",
              flexWrap: "wrap",
              marginBottom: 10,
            }}
          >
            <div style={{ fontWeight: 900, fontSize: 16 }}>
              Active project
            </div>

            <div style={{ display: "flex", gap: 8, flexWrap: "wrap" }}>
              <button type="button" onClick={() => nav("/app/projects")} style={buttonStyle()}>
                Projects
              </button>
              <button type="button" onClick={() => nav("/app/dashboard")} style={buttonStyle()}>
                Dashboard
              </button>
              <button type="button" onClick={() => nav("/app/projects/new")} style={buttonStyle(true)}>
                Start New Project
              </button>
            </div>
          </div>

          <div style={{ display: "flex", flexWrap: "wrap", gap: 8, marginBottom: 12 }}>
            <span style={chipStyle()}>Project: {activeProject?.name || "No active project"}</span>
            <span style={chipStyle()}>Status: {activeProject?.status || "Draft"}</span>
            <span style={chipStyle()}>SKUs: {selectedSkuCount}</span>
            <span style={chipStyle()}>Proposal: {activeProject?.proposal?.selectedTier || "None"}</span>
            <span style={chipStyle()}>Updated: {fmtDate(activeProject?.updatedAt)}</span>
          </div>

          <div style={{ display: "flex", gap: 8, flexWrap: "wrap" }}>
            <button type="button" onClick={() => nav(nextAction.to)} style={buttonStyle(true)}>
              {nextAction.label}
            </button>
            <button type="button" onClick={() => nav("/app/tools/discovery")} style={buttonStyle()}>
              Open Discovery
            </button>
            <button type="button" onClick={() => nav("/app/tools/catalog")} style={buttonStyle()}>
              Open Catalog
            </button>
            <button type="button" onClick={() => nav("/app/tools/proposal")} style={buttonStyle()}>
              Open Proposal
            </button>
          </div>
        </div>

        <div className="wm-tilegrid">
          {TOOLS.map((t) => (
            <ToolTile key={t.to} t={t} />
          ))}
        </div>
      </main>
    </div>
  );
}

