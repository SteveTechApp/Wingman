export type ProposalDocxMode = "rendered-docx" | "fallback-docx" | "fallback-json";

function esc(value: unknown): string {
  return String(value ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
}

