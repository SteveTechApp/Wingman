          onChange={(v) => update("urgency", v)}
        />

        <label className="wm-dw3__field wm-dw3__field--full">
          <span>Call notes / constraints</span>
          <textarea
            value={record.notes}
            placeholder="Known constraints, preferred platforms, cable routes, existing room tech, Teams / BYOD requirements, consultant preferences."
            onChange={(e) => update("notes", e.target.value)}
          />
        </label>
      </div>
    );
  }

  return (
    <div className="wm-dw3">
      <style>{styles}</style>

      <header className="wm-dw3__header">
        <div className="wm-dw3__title">
          <h1>Discovery Wizard</h1>
          <p>Guide the user step by step, reduce clutter, and keep the whole workflow visible without relying on page scroll.</p>

          <div className="wm-dw3__meta">
            <span className="wm-dw3__pill">Project: {show(record.roomName || record.customer || "Untitled")}</span>
            <span className="wm-dw3__pill">Progress: {totalComplete}/{totalFields}</span>
            <span className="wm-dw3__pill">Next: {recommendation.nextTool}</span>
          </div>
        </div>

        <div className="wm-dw3__actions">
          <button className="wm-dw3__btn wm-dw3__btn--ghost" onClick={startBlank}>
            Start blank
          </button>
          <button className="wm-dw3__btn" onClick={() => navigate("/app/tools")}>
            Back to Tool Hub
          </button>
          <button className="wm-dw3__btn wm-dw3__btn--primary" onClick={saveNow}>
            Save discovery
          </button>
          <button className="wm-dw3__btn wm-dw3__btn--primary" onClick={goCatalog}>
            Open Catalog
          </button>
        </div>
      </header>

      <div className="wm-dw3__workspace">
        <section className="wm-dw3__card">
          <div className="wm-dw3__stepTabs">
            {STEP_DEFS.map((step, index) => {
              const progress = stepCompletion(record, index);
              const active = index === activeStep;

              return (
                <button
                  key={step.id}
                  type="button"
                  className={`wm-dw3__stepTab${active ? " wm-dw3__stepTab--active" : ""}`}
                  onClick={() => setActiveStep(index)}
                >
                  <strong>Step {index + 1} - {step.title}</strong>
                  <span>{step.subtitle}</span>
                  <em>{progress.done}/{progress.total} complete</em>
                </button>
              );
            })}
          </div>

          <div className="wm-dw3__stepHead">
            <div>
              <h2>Step {activeStep + 1} - {currentStepMeta.title}</h2>
              <p>{currentStepMeta.subtitle}</p>
            </div>
            <div className="wm-dw3__stepBadge">
              {currentProgress.done}/{currentProgress.total} complete
            </div>
          </div>

          {renderStep()}

          <div className="wm-dw3__nav">
            <div className="wm-dw3__navLeft">
              <span className="wm-dw3__muted">
                {savedAt ? `Last saved at ${savedAt}` : "Not saved yet"}
              </span>
            </div>

            <div className="wm-dw3__navRight">
              <button
                className="wm-dw3__btn"
                onClick={() => setActiveStep((prev) => Math.max(0, prev - 1))}
                disabled={activeStep === 0}
              >
                Previous
              </button>

              {activeStep < STEP_DEFS.length - 1 ? (
                <button
                  className="wm-dw3__btn wm-dw3__btn--primary"
                  onClick={() => setActiveStep((prev) => Math.min(STEP_DEFS.length - 1, prev + 1))}
                >
                  Next
                </button>
              ) : (
                <button className="wm-dw3__btn wm-dw3__btn--primary" onClick={saveNow}>
                  Save discovery
                </button>
              )}
            </div>
          </div>
        </section>

        <aside className="wm-dw3__rail">
          <section className="wm-dw3__card">
            <div className="wm-dw3__summary">
              <div className="wm-dw3__summaryGroup">
                <h3>Project summary</h3>
                <SummaryRow label="Customer" value={show(record.customer)} />
                <SummaryRow label="Site" value={show(record.site)} />
                <SummaryRow label="Room" value={show(record.roomName)} />
                <SummaryRow label="Application" value={show(record.applicationType)} />
              </div>

              <div className="wm-dw3__summaryGroup">
                <h3>Layout</h3>
                <SummaryRow label="Room size" value={showSize(record)} />
                <SummaryRow label="Cable route" value={record.cableDistanceM ? `${record.cableDistanceM} m` : "-"} />
                <SummaryRow label="Display" value={show(record.displayLocation)} />
                <SummaryRow label="Source" value={show(record.sourceLocation)} />
                <SummaryRow label="Rack" value={show(record.rackLocation)} />
              </div>

              <div className="wm-dw3__summaryGroup">
                <h3>Qualifiers</h3>
                <SummaryRow label="Displays / sources" value={`${record.displayCount || "-"} / ${record.sourceCount || "-"}`} />
                <SummaryRow label="USB" value={show(record.usbNeeds)} />
                <SummaryRow label="Audio" value={show(record.audioNeeds)} />
                <SummaryRow label="Control" value={show(record.controlNeeds)} />
                <SummaryRow label="Budget" value={show(record.budgetBand)} />
                <SummaryRow label="Urgency" value={show(record.urgency)} />
              </div>
            </div>
          </section>

          <section className="wm-dw3__card">
            <h2 style={{ margin: 0, fontSize: "1.02rem", lineHeight: 1.1 }}>Recommended product families</h2>
            <p style={{ margin: "6px 0 10px", color: "rgba(232,241,255,0.72)", fontSize: "0.9rem" }}>
              Keep the recommendation visible while the user completes the wizard.
            </p>

            <div className="wm-dw3__chipRow">
              {recommendation.families.map((family) => (
                <span key={family} className="wm-dw3__chip">{family}</span>
              ))}
            </div>

            <ul className="wm-dw3__reasonList">
              {recommendation.reasons.map((reason) => (
                <li key={reason}>{reason}</li>
              ))}
            </ul>

            <div style={{ marginTop: 12, display: "flex", justifyContent: "space-between", gap: 8, alignItems: "center", flexWrap: "wrap" }}>
              <span className="wm-dw3__muted">Next tool: {recommendation.nextTool}</span>
              <button className="wm-dw3__btn wm-dw3__btn--primary" onClick={goCatalog}>
                Open Catalog
              </button>
            </div>
          </section>
        </aside>
      </div>
    </div>
  );
}