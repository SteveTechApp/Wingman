  display: grid;
  gap: 8px;
  margin-top: 12px;
}
.wm-review__listItem{
  padding: 10px 12px;
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,0.08);
  background: rgba(255,255,255,0.03);
  font-size: 13px;
  line-height: 1.45;
  color: rgba(255,255,255,0.86);
}
.wm-review__ok{
  color: rgba(134,239,172,0.96);
  font-weight: 700;
}
