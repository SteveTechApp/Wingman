import * as React from "react";
import { useNavigate } from "react-router-dom";
import { readDesignBundle, summariseDesignBundle } from "@/features/systemDesign/designBundleStore";

const styles = `
.wm-review{
  padding: 12px 16px 16px;
}
.wm-review__stack{
  display: grid;
  gap: 12px;
}
.wm-review__hero{
  display: grid;
  grid-template-columns: minmax(0,1fr) auto;
  gap: 12px;
  align-items: start;
  padding: 14px 16px;
  border-radius: 18px;
  border: 1px solid rgba(110,145,190,0.16);
  background:
    radial-gradient(circle at top right, rgba(25,83,173,0.16), transparent 36%),
    radial-gradient(circle at left center, rgba(34,199,184,0.10), transparent 30%),
    linear-gradient(180deg, rgba(13,22,37,0.96), rgba(7,13,24,0.96));
}
.wm-review__eyebrow{
  margin: 0 0 4px;
  color: #66eadb;
  font-size: .78rem;
  font-weight: 700;
  letter-spacing: .05em;
  text-transform: uppercase;
}
.wm-review__title{
  margin: 0;
  font-size: 1.7rem;
  line-height: 1.02;
  font-weight: 700;
  letter-spacing: -.02em;
}
.wm-review__subtitle{
  margin: 6px 0 0;
  color: rgba(232,241,255,0.74);
  font-size: .92rem;
  line-height: 1.32;
  max-width: 80ch;
}
.wm-review__grid{
  display: grid;
  grid-template-columns: minmax(0,1.2fr) minmax(0,.8fr);
  gap: 12px;
}
.wm-review__card{
  padding: 16px 18px;
  border-radius: 18px;
  border: 1px solid rgba(110,145,190,0.16);
  background: linear-gradient(180deg, rgba(13,22,37,0.94), rgba(7,13,24,0.94));
}
.wm-review__miniGrid{
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  gap: 10px;
  margin-top: 12px;
}
.wm-review__miniItem{
  padding: 10px 12px;
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,0.08);
  background: rgba(255,255,255,0.03);
}
.wm-review__miniItem strong{
  display: block;
  margin-bottom: 4px;
  font-size: .9rem;
  font-weight: 700;
}
