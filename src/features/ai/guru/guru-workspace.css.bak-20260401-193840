
.guru-actions__left {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.guru-secondary {
  appearance: none;
  border: 1px solid rgba(120, 113, 108, 0.18);
  background: rgba(255,255,255,0.04);
  color: #fafaf9;
  border-radius: 999px;
  padding: 12px 16px;
  font: inherit;
  font-weight: 700;
  cursor: pointer;
}

.guru-error {
  margin-top: 16px;
  padding: 14px 16px;
  border-radius: 16px;
  border: 1px solid rgba(239, 68, 68, 0.28);
  background: rgba(239, 68, 68, 0.08);
  color: #fecaca;
  line-height: 1.6;
  font-size: 14px;
}