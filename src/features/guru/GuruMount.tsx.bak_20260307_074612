export default function GuruMount() {
  const navigate = useNavigate();
  const location = useLocation();

  const [open, setOpen] = React.useState(false);
  const [seed, setSeed] = React.useState<DiscoverySeed>({});
  const [prompt, setPrompt] = React.useState("");

  const hidden = React.useMemo(() => {
    return location.pathname.startsWith("/app/tools/guru") || location.pathname.startsWith("/app/guru");
  }, [location.pathname]);

  React.useEffect(() => {
    if (!open) return;
    setSeed(readDiscoverySeed());
  }, [open, location.pathname]);

  React.useEffect(() => {
    if (!open) return;

    const previousOverflow = document.body.style.overflow;
    document.body.style.overflow = "hidden";

    const onKeyDown = (event: KeyboardEvent) => {
      if (event.key === "Escape") setOpen(false);
    };

    window.addEventListener("keydown", onKeyDown);
    return () => {
      document.body.style.overflow = previousOverflow;
      window.removeEventListener("keydown", onKeyDown);
    };
  }, [open]);

  const projectTitle = buildProjectTitle(seed);
  const stage = buildStage(location.pathname);
  const page = pageLabel(location.pathname);

  const promptOptions = [
    "Review the discovery context and tell me what inputs are still missing.",
    "What should I do next on this project?",
    "Summarise the current project for a sales handover.",
    "Recommend the next best Wingman tool to use.",
    "Suggest a WyreStorm starting point for this project.",
    "Explain why Apollo, HDBaseT or AVoIP may be suitable for this project.",
  ];

  const copyPrompt = async () => {
    try {
      await navigator.clipboard.writeText(prompt);
    } catch {
    }
  };

  const resetPrompt = () => setPrompt("");

  const openToolHub = () => {
    setOpen(false);
    navigate("/app/tools");
  };

  const openCatalog = () => {
    setOpen(false);
    navigate("/app/tools/catalog");
  };

  const overlay = open
    ? ReactDOM.createPortal(
        <div className="wm-guru2__overlay" onClick={() => setOpen(false)}>
          <style>{styles}</style>

          <section
            className="wm-guru2__panel"
            onClick={(e) => e.stopPropagation()}
            aria-modal="true"
            role="dialog"
            aria-label="Guru AV AI helper"
          >
            <header className="wm-guru2__header">
              <div className="wm-guru2__title">
                <small>Guru</small>
                <h2>AV AI helper</h2>
                <p>Use a contained assistant drawer with its own scrolling and clean project context.</p>
              </div>

              <button className="wm-guru2__close" type="button" onClick={() => setOpen(false)} aria-label="Close Guru">
                ×
              </button>
            </header>

            <div className="wm-guru2__body">
              <section className="wm-guru2__card">
                <h3>Active project</h3>
                <p className="wm-guru2__projectTitle">{projectTitle}</p>

                <div className="wm-guru2__projectMeta">
                  <span className="wm-guru2__pill">Stage: {stage}</span>
                  <span className="wm-guru2__pill">Page: {page}</span>
                  <span className="wm-guru2__pill">Status: Draft</span>
                </div>

                <div className="wm-guru2__projectLine">
                  {show(seed.customer)} • {show(seed.site)} • {show(seed.roomName)}
                </div>
              </section>

              <section className="wm-guru2__card">
                <h3>Suggested prompts</h3>
                <div className="wm-guru2__promptList">
                  {promptOptions.map((item) => (
                    <button
                      key={item}
                      type="button"
                      className="wm-guru2__promptBtn"
                      onClick={() => setPrompt(buildPrompt(seed, location.pathname, item))}
                    >
                      {item}
                    </button>
                  ))}
                </div>
              </section>

              <section className="wm-guru2__card">
                <h3>Project summary</h3>

                <div className="wm-guru2__summaryGroup">
                  <h4>Context</h4>
                  <SummaryRow label="Customer" value={show(seed.customer)} />
                  <SummaryRow label="Site" value={show(seed.site)} />
                  <SummaryRow label="Room" value={show(seed.roomName)} />
                  <SummaryRow label="Application" value={show(seed.applicationType)} />
                </div>

                <div className="wm-guru2__summaryGroup">
                  <h4>Layout</h4>
                  <SummaryRow
                    label="Room size"
                    value={
                      seed.roomLengthM || seed.roomWidthM || seed.roomHeightM
                        ? `${show(seed.roomLengthM)} x ${show(seed.roomWidthM)} x ${show(seed.roomHeightM)} m`
                        : "-"
                    }
                  />
                  <SummaryRow label="Cable route" value={seed.cableDistanceM ? `${seed.cableDistanceM} m` : "-"} />
                  <SummaryRow label="Display" value={show(seed.displayLocation)} />
                  <SummaryRow label="Source" value={show(seed.sourceLocation)} />
                  <SummaryRow label="Rack" value={show(seed.rackLocation)} />
                </div>

                <div className="wm-guru2__summaryGroup">
                  <h4>Qualifiers</h4>
                  <SummaryRow label="Displays / sources" value={`${seed.displayCount || "-"} / ${seed.sourceCount || "-"}`} />
                  <SummaryRow label="USB" value={show(seed.usbNeeds)} />
                  <SummaryRow label="Audio" value={show(seed.audioNeeds)} />
                  <SummaryRow label="Control" value={show(seed.controlNeeds)} />
                  <SummaryRow label="Budget" value={show(seed.budgetBand)} />
                  <SummaryRow label="Urgency" value={show(seed.urgency)} />
                </div>

                <div className="wm-guru2__chipRow">
                  {(seed.recommendedFamilies ?? []).map((family) => (
                    <span key={family} className="wm-guru2__chip">{family}</span>
                  ))}
                </div>
              </section>

              <section className="wm-guru2__card">
                <h3>Prompt builder</h3>
                <textarea
                  className="wm-guru2__textarea"
                  value={prompt}
                  onChange={(e) => setPrompt(e.target.value)}
                  placeholder="Select a suggested prompt or write your own Guru request here."
                />
              </section>
            </div>

            <footer className="wm-guru2__footer">
              <div className="wm-guru2__footerGroup">
                <button className="wm-guru2__btn wm-guru2__btn--primary" type="button" onClick={copyPrompt} disabled={!prompt.trim()}>
                  Copy Prompt
                </button>
                <button className="wm-guru2__btn" type="button" onClick={openToolHub}>
                  Open Tool Hub
                </button>
                <button className="wm-guru2__btn" type="button" onClick={openCatalog}>
                  Open Catalog
                </button>
              </div>

              <div className="wm-guru2__footerGroup">
                <button className="wm-guru2__btn" type="button" onClick={resetPrompt}>
                  Reset
                </button>
              </div>
            </footer>
          </section>
        </div>,
        document.body
      )
    : null;

  if (hidden) return null;

  return (
    <>
      <style>{styles}</style>

      {overlay}

      <button type="button" className="wm-guru2__fab" onClick={() => setOpen(true)} aria-label="Open Guru">
        ✦ Guru
      </button>
    </>
  );
}