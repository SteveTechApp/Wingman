type DiscoveryProductFamily =
  | "Apollo"
  | "HDBaseT"
  | "AVoIP"
  | "Matrix"
  | "USB Extension"
  | "Video Wall";

type DiscoverySeed = {
  customer?: string;
  site?: string;
  roomName?: string;
  applicationType?: string;
  roomLengthM?: string;
  roomWidthM?: string;
  roomHeightM?: string;
  displayLocation?: string;
  sourceLocation?: string;
  rackLocation?: string;
  cableDistanceM?: string;
  displayCount?: string;
  sourceCount?: string;
  usbNeeds?: string;
  audioNeeds?: string;
  controlNeeds?: string;
  budgetBand?: string;
  urgency?: string;
  notes?: string;
  recommendedFamilies?: DiscoveryProductFamily[];
  recommendedNextTool?: string;
};

const STORAGE_KEY = "wm_discovery_seed";

function readDiscoverySeed(): DiscoverySeed {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (!raw) return {};
    return JSON.parse(raw) as DiscoverySeed;
  } catch {
    return {};
  }
}

function show(value?: string): string {
  return value && value.trim() ? value : "-";
}

function pageLabel(pathname: string): string {
  if (pathname.includes("/tools/discovery")) return "Discovery Wizard";
  if (pathname.includes("/tools/catalog")) return "Product Catalog";
  if (pathname.includes("/tools/proposal")) return "Proposal Builder";
  if (pathname.includes("/tools/room")) return "Room Wizard";
  if (pathname.includes("/projects")) return "Projects";
  if (pathname.includes("/dashboard")) return "Dashboard";
  if (pathname.includes("/tools")) return "Tool Hub";
  return "Workspace";
}

function buildProjectTitle(seed: DiscoverySeed): string {
  return seed.roomName?.trim() || seed.customer?.trim() || "Untitled project";
}

function buildStage(pathname: string): string {
  if (pathname.includes("/tools/discovery")) return "Discovery";
  if (pathname.includes("/tools/catalog")) return "Selection";
  if (pathname.includes("/tools/proposal")) return "Proposal";
  if (pathname.includes("/projects")) return "Projects";
  return "Workspace";
}

function buildSummary(seed: DiscoverySeed): string {
  const roomSize =
    seed.roomLengthM || seed.roomWidthM || seed.roomHeightM
      ? `${show(seed.roomLengthM)} x ${show(seed.roomWidthM)} x ${show(seed.roomHeightM)} m`
      : "-";

  return [
    `Customer: ${show(seed.customer)}`,
    `Site: ${show(seed.site)}`,
    `Room: ${show(seed.roomName)}`,
    `Application: ${show(seed.applicationType)}`,
    `Room size: ${roomSize}`,
    `Cable route: ${seed.cableDistanceM ? `${seed.cableDistanceM} m` : "-"}`,
    `Display location: ${show(seed.displayLocation)}`,
    `Source location: ${show(seed.sourceLocation)}`,
    `Rack location: ${show(seed.rackLocation)}`,
    `Displays / sources: ${seed.displayCount || "-"} / ${seed.sourceCount || "-"}`,
    `USB: ${show(seed.usbNeeds)}`,
    `Audio: ${show(seed.audioNeeds)}`,
    `Control: ${show(seed.controlNeeds)}`,
    `Budget: ${show(seed.budgetBand)}`,
    `Urgency: ${show(seed.urgency)}`,
    `Recommended families: ${(seed.recommendedFamilies ?? []).join(", ") || "-"}`,
    `Next tool: ${show(seed.recommendedNextTool)}`,
    `Notes: ${show(seed.notes)}`,
  ].join("\n");
}

function buildPrompt(seed: DiscoverySeed, pathname: string, ask: string): string {
  return [
    "You are Wingman Guru, an AV sales and design assistant for WyreStorm.",
    "",
    `Current page: ${pageLabel(pathname)}`,
    `Current stage: ${buildStage(pathname)}`,
    "",
    "Project summary:",
    buildSummary(seed),
    "",
    `Task: ${ask}`,
  ].join("\n");
}

function SummaryRow(props: { label: string; value: string }) {
  return (
    <div className="wm-guru2__summaryRow">
      <span>{props.label}</span>
      <strong>{props.value}</strong>
    </div>
  );
}

