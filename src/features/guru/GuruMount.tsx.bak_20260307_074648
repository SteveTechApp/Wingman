export default function GuruMount() {
  const navigate = useNavigate();
  const location = useLocation();

  const [open, setOpen] = React.useState(false);
  const [seed, setSeed] = React.useState<DiscoverySeed>({});
  const [prompt, setPrompt] = React.useState("");

  const hidden = React.useMemo(() => {
    return location.pathname.startsWith("/app/tools/guru") || location.pathname.startsWith("/app/guru");
  }, [location.pathname]);

  React.useEffect(() => {
    if (!open) return;
    setSeed(readDiscoverySeed());
  }, [open, location.pathname]);

  React.useEffect(() => {
    if (!open) return;

    const previousOverflow = document.body.style.overflow;
    document.body.style.overflow = "hidden";

    const onKeyDown = (event: KeyboardEvent) => {
      if (event.key === "Escape") setOpen(false);
    };

    window.addEventListener("keydown", onKeyDown);
    return () => {
      document.body.style.overflow = previousOverflow;
      window.removeEventListener("keydown", onKeyDown);
    };
  }, [open]);

  const projectTitle = buildProjectTitle(seed);
  const stage = buildStage(location.pathname);
  const page = pageLabel(location.pathname);

  const quickAsks = [
    "Tell me what is still missing.",
    "What should I do next?",
    "Summarise this project for handover.",
    "Suggest a WyreStorm starting point.",
  ];

  const insertQuickAsk = (ask: string) => {
    setPrompt(buildPrompt(seed, location.pathname, ask));
  };

  const insertContextOnly = () => {
    setPrompt([
      "You are Wingman Guru, an AV sales and design assistant for WyreStorm.",
      "",
      `Current page: ${page}`,
      `Current stage: ${stage}`,
      "",
      "Project summary:",
      buildSummary(seed),
      "",
      "Task: ",
    ].join("\n"));
  };

  const copyPrompt = async () => {
    try {
      await navigator.clipboard.writeText(prompt);
    } catch {
    }
  };

  const resetPrompt = () => setPrompt("");

  const openToolHub = () => {
    setOpen(false);
    navigate("/app/tools");
  };

  const openCatalog = () => {
    setOpen(false);
    navigate("/app/tools/catalog");
  };

  const overlay = open
    ? ReactDOM.createPortal(
        <div className="wm-guru3__overlay" onClick={() => setOpen(false)}>
          <style>{styles}</style>

          <section
            className="wm-guru3__panel"
            onClick={(e) => e.stopPropagation()}
            aria-modal="true"
            role="dialog"
            aria-label="Guru AV AI helper"
          >
            <header className="wm-guru3__header">
              <div className="wm-guru3__title">
                <small>Guru</small>
                <h2>AV AI helper</h2>
                <p>Project snapshot, quick asks, and one clean prompt box.</p>
              </div>

              <button className="wm-guru3__close" type="button" onClick={() => setOpen(false)} aria-label="Close Guru">
                ×
              </button>
            </header>

            <div className="wm-guru3__body">
              <section className="wm-guru3__card">
                <h3>Active project</h3>
                <p className="wm-guru3__projectTitle">{projectTitle}</p>

                <div className="wm-guru3__meta">
                  <span className="wm-guru3__pill">Stage: {stage}</span>
                  <span className="wm-guru3__pill">Page: {page}</span>
                  <span className="wm-guru3__pill">Status: Draft</span>
                </div>

                <div className="wm-guru3__projectLine">
                  {show(seed.customer)} • {show(seed.site)} • {show(seed.roomName)}
                </div>

                <div className="wm-guru3__meta">
                  <span className="wm-guru3__pill">Application: {show(seed.applicationType)}</span>
                  <span className="wm-guru3__pill">Room size: {roomSize(seed)}</span>
                  <span className="wm-guru3__pill">
                    Displays / sources: {seed.displayCount || "-"} / {seed.sourceCount || "-"}
                  </span>
                </div>

                {(seed.recommendedFamilies ?? []).length > 0 ? (
                  <div className="wm-guru3__meta">
                    {(seed.recommendedFamilies ?? []).map((family) => (
                      <span key={family} className="wm-guru3__pill">{family}</span>
                    ))}
                  </div>
                ) : null}
              </section>

              <section className="wm-guru3__card">
                <h3>Quick asks</h3>
                <div className="wm-guru3__chips">
                  {quickAsks.map((ask) => (
                    <button
                      key={ask}
                      type="button"
                      className="wm-guru3__chip"
                      onClick={() => insertQuickAsk(ask)}
                    >
                      {ask}
                    </button>
                  ))}
                  <button
                    type="button"
                    className="wm-guru3__chip"
                    onClick={insertContextOnly}
                  >
                    Insert project context
                  </button>
                  {seed.recommendedNextTool ? (
                    <span className="wm-guru3__chip wm-guru3__chip--accent">
                      Next tool: {seed.recommendedNextTool}
                    </span>
                  ) : null}
                </div>
              </section>

              <section className="wm-guru3__card">
                <h3>Prompt</h3>
                <textarea
                  className="wm-guru3__textarea"
                  value={prompt}
                  onChange={(e) => setPrompt(e.target.value)}
                  placeholder="Write your Guru request here, or tap a quick ask above."
                />
                <div className="wm-guru3__helper">
                  Keep this simple. Use a quick ask for structured context, then edit the prompt if needed.
                </div>
              </section>
            </div>

            <footer className="wm-guru3__footer">
              <div className="wm-guru3__footerGroup">
                <button className="wm-guru3__btn wm-guru3__btn--primary" type="button" onClick={copyPrompt} disabled={!prompt.trim()}>
                  Copy Prompt
                </button>
                <button className="wm-guru3__btn" type="button" onClick={openCatalog}>
                  Open Catalog
                </button>
                <button className="wm-guru3__btn" type="button" onClick={openToolHub}>
                  Tool Hub
                </button>
              </div>

              <div className="wm-guru3__footerGroup">
                <button className="wm-guru3__btn" type="button" onClick={resetPrompt}>
                  Reset
                </button>
              </div>
            </footer>
          </section>
        </div>,
        document.body
      )
    : null;

  if (hidden) return null;

  return (
    <>
      <style>{styles}</style>

      {overlay}

      <button type="button" className="wm-guru3__fab" onClick={() => setOpen(true)} aria-label="Open Guru">
        ✦ Guru
      </button>
    </>
  );
}