{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wyrestorm.example/schemas/roomProfile-1.0.json",
  "title": "RoomProfile v1.0",
  "type": "object",
  "required": ["roomProfileVersion", "roomName", "roomType", "usageModes", "displayCount", "displayType", "displayResolutionTarget", "sources", "audioMode", "controlLevel"],
  "properties": {
    "roomProfileVersion": { "type": "string", "const": "1.0" },
    "roomName": { "type": "string", "minLength": 1 },
    "roomType": { "type": "string" },
    "occupancy": { "type": "number" },
    "dimensionsMeters": {
      "type": "object",
      "properties": {
        "length": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" }
      },
      "additionalProperties": false
    },
    "usageModes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "displayCount": { "type": "number", "minimum": 1 },
    "displayType": { "type": "string" },
    "displayResolutionTarget": { "type": "string" },
    "displayInterfaces": { "type": "array", "items": { "type": "string" } },
    "contentDistribution": { "type": "string" },
    "localPreviewNeeded": { "type": "boolean" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sourceType", "connectionPreference", "count"],
        "properties": {
          "sourceType": { "type": "string" },
          "connectionPreference": { "type": "string" },
          "count": { "type": "number", "minimum": 1 },
          "needsCharging": { "type": "boolean" },
          "chargingWatts": { "type": "number" },
          "isGuestDevice": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "audioMode": { "type": "string" },
    "vc": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "platform": { "type": "string" },
        "computeMode": { "type": "string" },
        "cameraCount": { "type": "number" },
        "cameraType": { "type": "string" },
        "contentToCall": { "type": "boolean" },
        "usbPeripheralsRequired": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "controlLevel": { "type": "string" },
    "autoSwitching": { "type": "boolean" },
    "roomSchedulingPanel": { "type": "boolean" },
    "constraints": {
      "type": "object",
      "properties": {
        "maxCableRunMeters": { "type": "number" },
        "cableInfrastructure": { "type": "string" },
        "networkAvailable": { "type": "boolean" },
        "vlanAvailable": { "type": "boolean" },
        "poeAvailable": { "type": "string" },
        "redundancyRequired": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "commercial": {
      "type": "object",
      "properties": {
        "budgetBand": { "type": "string" },
        "region": { "type": "string" },
        "riskTolerance": { "type": "string" },
        "mustHaves": { "type": "array", "items": { "type": "string" } },
        "niceToHaves": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}